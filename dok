EOF
}

# ------------------------------------------------------------------------------
# Core Actions: start, stop, restart, status
# ------------------------------------------------------------------------------
start_dokploy() {
  local mode="$1"
  check_docker

  echo -e "${BOLD}[${CMD_NAME}]${NC} Starting core Dokploy services..."
  $DOCKER_BIN service scale dokploy=1 dokploy-postgres=1
  $DOCKER_BIN start dokploy-traefik >/dev/null 2>&1 || true

  if [ "$mode" != "--core" ] && [ "$mode" != "-c" ]; then
    if [ -f "$SVC_STATE" ] && [ -s "$SVC_STATE" ]; then
      echo -e "${BOLD}[${CMD_NAME}]${NC} Restoring previously active Dokploy apps/services..."
      while IFS='=' read -r svc_name replicas; do
        if [ -n "$svc_name" ] && [ -n "$replicas" ]; then
          echo -e "  ${GREEN}->${NC} Restoring service: ${BOLD}$svc_name${NC} (replicas: $replicas)"
          $DOCKER_BIN service scale "$svc_name=$replicas" >/dev/null 2>&1 || true
        fi
      done < "$SVC_STATE"
      rm -f "$SVC_STATE"
    fi

    if [ -f "$CONT_STATE" ] && [ -s "$CONT_STATE" ]; then
      echo -e "${BOLD}[${CMD_NAME}]${NC} Restoring previously active Dokploy containers..."
      while IFS= read -r c_id; do
        if [ -n "$c_id" ]; then
          echo -e "  ${GREEN}->${NC} Starting container: ${BOLD}$c_id${NC}"
          $DOCKER_BIN start "$c_id" >/dev/null 2>&1 || true
        fi
      done < "$CONT_STATE"
      rm -f "$CONT_STATE"
    fi
  else
    echo -e "${DIM}Core mode: skipped restoring user services.${NC}"
  fi

  echo -e "${GREEN}✔${NC} Dokploy started successfully!"
  echo -e "  Dashboard: ${CYAN}${BOLD}http://localhost:${DOKPLOY_PORT}${NC}"
  echo -e "  Run ${DIM}'${CMD_NAME} status'${NC} to view running services."
}

stop_dokploy() {
  local mode="$1"
  check_docker

  # If --core, only stop dokploy and dokploy-postgres
  if [ "$mode" = "--core" ] || [ "$mode" = "-c" ]; then
    echo -e "${BOLD}[${CMD_NAME}]${NC} Stopping only Dokploy core services..."
    $DOCKER_BIN service scale dokploy=0 dokploy-postgres=0
    echo -e "${YELLOW}✔${NC} Dokploy core stopped. User applications and Traefik remain running."
    return 0
  fi

  # Without --core: Stop ALL (user apps + dokploy + dokploy-postgres + dokploy-traefik)
  ensure_state_dir
  > "$SVC_STATE"
  > "$CONT_STATE"

  echo -e "${BOLD}[${CMD_NAME}]${NC} Scanning for active Dokploy user applications..."
  local net_id
  net_id=$(get_dokploy_net_id)

  if [ -n "$net_id" ]; then
    # 1. Detect and scale down Swarm services on dokploy-network (excluding core)
    for s_id in $($DOCKER_BIN service ls -q 2>/dev/null); do
      local name
      name=$($DOCKER_BIN service inspect --format '{{.Spec.Name}}' "$s_id" 2>/dev/null)
      if [ "$name" = "dokploy" ] || [ "$name" = "dokploy-postgres" ]; then
        continue
      fi

      local is_on_net
      is_on_net=$($DOCKER_BIN service inspect --format '{{range .Spec.TaskTemplate.Networks}}{{.Target}} {{end}}' "$s_id" 2>/dev/null | grep -w "$net_id" || true)
      if [ -n "$is_on_net" ]; then
        local replicas
        replicas=$($DOCKER_BIN service inspect --format '{{if .Spec.Mode.Replicated}}{{.Spec.Mode.Replicated.Replicas}}{{else}}0{{end}}' "$s_id" 2>/dev/null)
        if [ "$replicas" -gt 0 ]; then
          echo -e "  ${YELLOW}->${NC} Stopping service: ${BOLD}$name${NC} (was $replicas replicas)"
          echo "$name=$replicas" >> "$SVC_STATE"
          $DOCKER_BIN service scale "$name=0" >/dev/null 2>&1 || true
        fi
      fi
    done

    # 2. Detect and stop standalone containers on dokploy-network
    $DOCKER_BIN ps --filter "network=$DOKPLOY_NETWORK" --format '{{.ID}} {{.Names}} {{.Label "com.docker.swarm.service.name"}}' 2>/dev/null | while IFS= read -r line; do
      [ -z "$line" ] && continue
      local c_id c_name swarm_svc
      c_id=$(echo "$line" | awk '{print $1}')
      c_name=$(echo "$line" | awk '{print $2}')
      swarm_svc=$(echo "$line" | awk '{print $3}')

      if [ "$c_name" = "dokploy-traefik" ] || [ -n "$swarm_svc" ]; then
        continue
      fi

      echo -e "  ${YELLOW}->${NC} Stopping standalone container: ${BOLD}$c_name${NC} ($c_id)"
      echo "$c_id" >> "$CONT_STATE"
      $DOCKER_BIN stop "$c_id" >/dev/null 2>&1 || true
    done
  fi

  echo -e "${BOLD}[${CMD_NAME}]${NC} Stopping core Dokploy services..."
  $DOCKER_BIN service scale dokploy=0 dokploy-postgres=0
  $DOCKER_BIN stop dokploy-traefik >/dev/null 2>&1 || true

  echo -e "${GREEN}✔${NC} Dokploy and all associated applications stopped. CPU and RAM freed!"
}

status_dokploy() {
  check_docker

  echo -e "${BOLD}======================================================${NC}"
  echo -e "${BOLD} Dokploy Local Development Status  (${CYAN}${CMD_NAME}${NC}${BOLD})${NC}"
  echo -e "${BOLD}======================================================${NC}"

  # Core Dokploy Swarm Services
  echo -e "\n${BOLD}${CYAN}Core Dokploy Services:${NC}"
  $DOCKER_BIN service ls --filter "name=dokploy" --format "table {{.Name}}\t{{.Mode}}\t{{.Replicas}}\t{{.Image}}"

  # Dokploy Traefik
  echo -e "\n${BOLD}${CYAN}Dokploy Traefik Proxy:${NC}"
  $DOCKER_BIN ps -a --filter "name=dokploy-traefik" --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"

  # User Applications
  echo -e "\n${BOLD}${CYAN}Dokploy User Applications & Services:${NC}"
  local user_apps
  user_apps=$($DOCKER_BIN service ls --format "table {{.Name}}\t{{.Mode}}\t{{.Replicas}}\t{{.Image}}" 2>/dev/null | grep -v -E "^(dokploy|dokploy-postgres)[[:space:]]" || true)
  if [ -n "$user_apps" ]; then
    echo "$user_apps"
  else
    echo -e "${DIM}No user applications currently deployed.${NC}"
  fi

  # Check if core panel is running
  local panel_replicas
  panel_replicas=$($DOCKER_BIN service inspect dokploy --format '{{if .Spec.Mode.Replicated}}{{.Spec.Mode.Replicated.Replicas}}{{else}}0{{end}}' 2>/dev/null || echo "0")
  echo ""
  if [ "$panel_replicas" -gt 0 ]; then
    echo -e "${GREEN}●${NC} Dokploy Web Dashboard: ${CYAN}${BOLD}http://localhost:${DOKPLOY_PORT}${NC}"
  else
    echo -e "${YELLOW}○${NC} Dokploy is currently stopped. Run ${BOLD}'${CMD_NAME} start'${NC} to start."
  fi
}

# ------------------------------------------------------------------------------
# Logs Command
# ------------------------------------------------------------------------------
logs_dokploy() {
  check_docker
  local target="${1:-panel}"
  shift || true

  local extra_args=()
  while [ $# -gt 0 ]; do
    extra_args+=("$1")
    shift
  done

  case "$target" in
    panel|web|core)
      echo -e "${BOLD}[${CMD_NAME}]${NC} Logs for ${BOLD}dokploy${NC} web panel:"
      $DOCKER_BIN service logs "${extra_args[@]}" dokploy
      ;;
    db|postgres)
      echo -e "${BOLD}[${CMD_NAME}]${NC} Logs for ${BOLD}dokploy-postgres${NC} database:"
      $DOCKER_BIN service logs "${extra_args[@]}" dokploy-postgres
      ;;
    traefik|proxy)
      echo -e "${BOLD}[${CMD_NAME}]${NC} Logs for ${BOLD}dokploy-traefik${NC} reverse proxy:"
      $DOCKER_BIN logs "${extra_args[@]}" dokploy-traefik
      ;;
    *)
      # Check if matching Swarm service exists
      if $DOCKER_BIN service inspect "$target" >/dev/null 2>&1; then
        echo -e "${BOLD}[${CMD_NAME}]${NC} Logs for Swarm service: ${BOLD}$target${NC}"
        $DOCKER_BIN service logs "${extra_args[@]}" "$target"
      elif $DOCKER_BIN inspect "$target" >/dev/null 2>&1; then
        echo -e "${BOLD}[${CMD_NAME}]${NC} Logs for container: ${BOLD}$target${NC}"
        $DOCKER_BIN logs "${extra_args[@]}" "$target"
      else
        echo -e "${RED}Error:${NC} No Dokploy service or container named '${target}' found." >&2
        echo "Valid targets: panel, db, traefik, or any running service name." >&2
        exit 1
      fi
      ;;
  esac
}

# ------------------------------------------------------------------------------
# Open in Browser
# ------------------------------------------------------------------------------
open_dashboard() {
  local url="http://localhost:${DOKPLOY_PORT}"
  echo -e "${BOLD}[${CMD_NAME}]${NC} Opening Dokploy dashboard: ${CYAN}${url}${NC}"

  if [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; then
    if command -v xdg-open >/dev/null 2>&1; then
      xdg-open "$url" >/dev/null 2>&1 &
      return 0
    elif command -v sensible-browser >/dev/null 2>&1; then
      sensible-browser "$url" >/dev/null 2>&1 &
      return 0
    elif command -v x-www-browser >/dev/null 2>&1; then
      x-www-browser "$url" >/dev/null 2>&1 &
      return 0
    fi
  fi
  echo -e "Visit ${BOLD}${CYAN}${url}${NC} in your web browser."
}

# ------------------------------------------------------------------------------
# Clean & Prune Artifacts
# ------------------------------------------------------------------------------
clean_dokploy() {
  check_docker
  local force=false
  local prune_all=false

  for arg in "$@"; do
    case "$arg" in
      -f|--force) force=true ;;
      -a|--all) prune_all=true ;;
    esac
  done

  if [ "$force" = false ]; then
    echo -e "${YELLOW}Warning:${NC} This will prune stopped Docker containers and dangling images."
    read -r -p "Are you sure you want to proceed? [y/N]: " confirm
    case "$confirm" in
      [yY][eE][sS]|[yY]) ;;
      *) echo "Aborted."; return 0 ;;
    esac
  fi

  echo -e "${BOLD}[${CMD_NAME}]${NC} Pruning stopped containers..."
  $DOCKER_BIN container prune -f
  echo -e "${BOLD}[${CMD_NAME}]${NC} Pruning dangling images..."
  $DOCKER_BIN image prune -f

  if [ "$prune_all" = true ]; then
    echo -e "${BOLD}[${CMD_NAME}]${NC} Pruning build cache..."
    $DOCKER_BIN builder prune -f
  fi

  echo -e "${GREEN}✔${NC} Docker cleanup complete."
}

# ------------------------------------------------------------------------------
# Install Dokploy & Autostart Management
# ------------------------------------------------------------------------------
install_dokploy() {
  check_docker

  echo -e "${BOLD}[${CMD_NAME}]${NC} Installing Dokploy for local development..."

  # 1. Initialize Docker Swarm if not active
  local swarm_state
  swarm_state=$($DOCKER_BIN info --format '{{.Swarm.LocalNodeState}}' 2>/dev/null || echo "inactive")
  if [ "$swarm_state" != "active" ]; then
    echo -e "  ${CYAN}->${NC} Initializing Docker Swarm..."
    $DOCKER_BIN swarm init >/dev/null 2>&1 || true
  fi

  # 2. Run official Dokploy installer
  echo -e "  ${CYAN}->${NC} Fetching and executing official Dokploy installer..."
  if command -v curl >/dev/null 2>&1; then
    curl -sSL https://dokploy.com/install.sh | sh
  elif command -v wget >/dev/null 2>&1; then
    wget -qO- https://dokploy.com/install.sh | sh
  else
    echo -e "${RED}Error:${NC} Neither 'curl' nor 'wget' was found. Please install one first." >&2
    exit 1
  fi

  # 3. Allow Dokploy services a moment to settle before reconfiguring
  echo -e "\n${BOLD}[${CMD_NAME}]${NC} Post-installation: removing auto-startup on boot..."
  sleep 4

  # 4. Remove auto-startup and stop to save RAM/CPU
  disable_autostart_dokploy --quiet

  echo -e "\n${GREEN}✔ Dokploy successfully installed and configured for local development!${NC}"
  echo -e "  ${BOLD}Auto-Startup on Boot:${NC} ${RED}DISABLED${NC}"
  echo -e "  Dokploy and Traefik will ${BOLD}NOT${NC} start automatically when your system or Docker boots."
  echo -e "  Whenever you want to use Dokploy, run:"
  echo -e "    ${CYAN}${BOLD}${CMD_NAME} start${NC}         # Start Dokploy + Traefik"
  echo -e "    ${CYAN}${BOLD}${CMD_NAME} start --core${NC}  # Start only Dokploy panel & DB"
  echo -e "    ${CYAN}${BOLD}${CMD_NAME} stop${NC}          # Stop Dokploy & free all RAM"
}

disable_autostart_dokploy() {
  check_docker
  local quiet=false
  [ "${1:-}" = "--quiet" ] && quiet=true

  if [ "$quiet" = false ]; then
    echo -e "${BOLD}[${CMD_NAME}]${NC} Removing auto-startup for Dokploy and Traefik..."
  fi

  # 1. Disable restart on Traefik container
  if $DOCKER_BIN inspect dokploy-traefik >/dev/null 2>&1; then
    [ "$quiet" = false ] && echo -e "  ${YELLOW}->${NC} Disabling restart on dokploy-traefik (--restart=no)..."
    $DOCKER_BIN update --restart=no dokploy-traefik >/dev/null 2>&1 || true
    $DOCKER_BIN stop dokploy-traefik >/dev/null 2>&1 || true
  fi

  # 2. Disable restart condition on Swarm services and scale down
  if $DOCKER_BIN service inspect dokploy >/dev/null 2>&1; then
    [ "$quiet" = false ] && echo -e "  ${YELLOW}->${NC} Disabling restart-condition on dokploy service..."
    $DOCKER_BIN service update --restart-condition none dokploy >/dev/null 2>&1 || true
    $DOCKER_BIN service scale dokploy=0 >/dev/null 2>&1 || true
  fi

  if $DOCKER_BIN service inspect dokploy-postgres >/dev/null 2>&1; then
    [ "$quiet" = false ] && echo -e "  ${YELLOW}->${NC} Disabling restart-condition on dokploy-postgres service..."
    $DOCKER_BIN service update --restart-condition none dokploy-postgres >/dev/null 2>&1 || true
    $DOCKER_BIN service scale dokploy-postgres=0 >/dev/null 2>&1 || true
  fi

  if [ "$quiet" = false ]; then
    echo -e "${GREEN}✔ Auto-startup disabled.${NC}"
    echo -e "  Dokploy core services and Traefik are stopped and will not launch on boot."
    echo -e "  Run ${CYAN}${BOLD}${CMD_NAME} start${NC} whenever you wish to use Dokploy."
  fi
}

enable_autostart_dokploy() {
  check_docker
  echo -e "${BOLD}[${CMD_NAME}]${NC} Enabling auto-startup on boot for Dokploy and Traefik..."

  if $DOCKER_BIN inspect dokploy-traefik >/dev/null 2>&1; then
    echo -e "  ${GREEN}->${NC} Setting Traefik restart policy to 'always'..."
    $DOCKER_BIN update --restart=always dokploy-traefik >/dev/null 2>&1 || true
    $DOCKER_BIN start dokploy-traefik >/dev/null 2>&1 || true
  fi

  if $DOCKER_BIN service inspect dokploy >/dev/null 2>&1; then
    echo -e "  ${GREEN}->${NC} Setting Dokploy service restart condition to 'any'..."
    $DOCKER_BIN service update --restart-condition any dokploy >/dev/null 2>&1 || true
    $DOCKER_BIN service scale dokploy=1 >/dev/null 2>&1 || true
  fi

  if $DOCKER_BIN service inspect dokploy-postgres >/dev/null 2>&1; then
    echo -e "  ${GREEN}->${NC} Setting Postgres service restart condition to 'any'..."
    $DOCKER_BIN service update --restart-condition any dokploy-postgres >/dev/null 2>&1 || true
    $DOCKER_BIN service scale dokploy-postgres=1 >/dev/null 2>&1 || true
  fi

  echo -e "${GREEN}✔ Auto-startup enabled.${NC}"
  echo -e "  Dokploy will now automatically start when Docker or your PC boots."
}

status_autostart_dokploy() {
  check_docker
  echo -e "${BOLD}Dokploy Auto-Startup Status:${NC}"

  local traefik_policy dok_cond pg_cond
  traefik_policy=$($DOCKER_BIN inspect dokploy-traefik --format '{{.HostConfig.RestartPolicy.Name}}' 2>/dev/null || echo "not-found")
  dok_cond=$($DOCKER_BIN service inspect dokploy --format '{{.Spec.TaskTemplate.RestartPolicy.Condition}}' 2>/dev/null || echo "not-found")
  pg_cond=$($DOCKER_BIN service inspect dokploy-postgres --format '{{.Spec.TaskTemplate.RestartPolicy.Condition}}' 2>/dev/null || echo "not-found")

  echo -e "  Traefik container restart policy: ${CYAN}${traefik_policy}${NC}"
  echo -e "  Dokploy panel restart condition:  ${CYAN}${dok_cond}${NC}"
  echo -e "  Dokploy database restart condition: ${CYAN}${pg_cond}${NC}"

  if [ "$traefik_policy" = "no" ] && [ "$dok_cond" = "none" ]; then
    echo -e "\nStatus: ${GREEN}Auto-startup is DISABLED.${NC} (Dokploy only runs on '${CMD_NAME} start')"
  else
    echo -e "\nStatus: ${YELLOW}Auto-startup is ENABLED.${NC} (Dokploy starts automatically on boot)"
    echo -e "To disable: ${CYAN}${CMD_NAME} autostart disable${NC} (or ${CYAN}${CMD_NAME} disable-autostart${NC})"
  fi
}

manage_autostart() {
  local action="${1:-status}"
  case "$action" in
    disable|off) disable_autostart_dokploy ;;
    enable|on) enable_autostart_dokploy ;;
    status|"") status_autostart_dokploy ;;
    *)
      echo "Usage: ${CMD_NAME} autostart [status|disable|enable]"
      ;;
  esac
}

# ------------------------------------------------------------------------------
# Uninstall Dokploy Local CLI
# ------------------------------------------------------------------------------
uninstall_cli() {
  local force=false
  for arg in "$@"; do
    case "$arg" in
      -f|--force|-y|--yes) force=true ;;
    esac
  done

  if [ "$force" = false ]; then
    echo -e "${YELLOW}Warning:${NC} This will remove the Dokploy CLI executable, aliases, and shell completions."
    read -r -p "Are you sure you want to uninstall? [y/N]: " confirm
    case "$confirm" in
      [yY][eE][sS]|[yY]) ;;
      *) echo "Uninstallation aborted."; return 0 ;;
    esac
  fi

  echo -e "${YELLOW}Uninstalling Dokploy CLI...${NC}"
  local bin_dir
  bin_dir="$(cd "$(dirname "$0")" && pwd)"

  # Remove binaries and symlinks from directory
  for name in dok dk dokploy "$CMD_NAME" "$CLI_NAME"; do
    if [ -f "$bin_dir/$name" ] || [ -L "$bin_dir/$name" ]; then
      echo -e "  Removing: $bin_dir/$name"
      rm -f "$bin_dir/$name"
    fi
  done

  # Remove completions from shell configuration files
  for rc in "$HOME/.bashrc" "$HOME/.zshrc"; do
    if [ -f "$rc" ]; then
      sed -i '/# >>> dokploy-cli autocompletion >>>/,/# <<< dokploy-cli autocompletion <<</d' "$rc" 2>/dev/null || true
    fi
  done

  # Remove config
  if [ -d "$CONFIG_DIR" ]; then
    echo -e "  Removing configuration: $CONFIG_DIR"
    rm -rf "$CONFIG_DIR"
  fi

  echo -e "${GREEN}✔ Dokploy Local CLI has been completely uninstalled.${NC}"
  exit 0
}

# ------------------------------------------------------------------------------
# Alias & Command Name Management
# ------------------------------------------------------------------------------
manage_alias() {
  local action="${1:-list}"
  local new_alias="$2"

  local bin_dir
  bin_dir="$(cd "$(dirname "$0")" && pwd)"
  local target_file
  target_file="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

  case "$action" in
    add)
      if [ -z "$new_alias" ]; then
        echo -e "${RED}Error:${NC} Please specify an alias name: ${CMD_NAME} alias add <name>"
        echo -e "Examples: ${CYAN}${CMD_NAME} alias add dk${NC} or ${CYAN}${CMD_NAME} alias add dok${NC}"
        exit 1
      fi
      if [ -e "$bin_dir/$new_alias" ] && [ ! -L "$bin_dir/$new_alias" ]; then
        echo -e "${RED}Error:${NC} File '$bin_dir/$new_alias' already exists and is not a symlink."
        exit 1
      fi

      ln -sf "$target_file" "$bin_dir/$new_alias"
      echo -e "${GREEN}✔${NC} Successfully added alias: ${BOLD}${CYAN}$new_alias${NC}"
      echo -e "You can now run commands as:"
      echo -e "  ${CYAN}$new_alias start${NC}"
      echo -e "  ${CYAN}$new_alias stop${NC}"
      echo -e "  ${CYAN}$new_alias status${NC}"
      ;;
    set)
      if [ -z "$new_alias" ]; then
        echo -e "${RED}Error:${NC} Please specify the primary name: ${CMD_NAME} alias set <name>"
        exit 1
      fi
      mkdir -p "$CONFIG_DIR"
      echo "CLI_NAME=\"$new_alias\"" > "$CONFIG_FILE"
      echo -e "${GREEN}✔${NC} Primary command name set to: ${BOLD}${CYAN}$new_alias${NC} in $CONFIG_FILE"
      ;;
    list|"")
      echo -e "${BOLD}Dokploy CLI Command Words & Aliases:${NC}"
      echo -e "  Currently running as: ${CYAN}${BOLD}$CMD_NAME${NC}"
      echo -e "  Configured default:   ${CYAN}${CLI_NAME}${NC}"
      echo -e "\nAvailable in ${bin_dir}:"
      for f in "$bin_dir"/dok* "$bin_dir"/dk*; do
        if [ -x "$f" ]; then
          local base
          base=$(basename "$f")
          if [ -L "$f" ]; then
            echo -e "  - ${CYAN}$base${NC} ${DIM}-> $(readlink "$f")${NC}"
          else
            echo -e "  - ${CYAN}${BOLD}$base${NC} (binary executable)"
          fi
        fi
      done
      echo -e "\n${DIM}Add another alias:${NC} ${CMD_NAME} alias add <name>"
      ;;
    *)
      echo "Usage: ${CMD_NAME} alias [list|add <name>|set <name>]"
      ;;
  esac
}

# ------------------------------------------------------------------------------
# Shell Completion Generators
# ------------------------------------------------------------------------------
generate_bash_completion() {
  cat << 'EOF'
_dokploy_completion() {
  local cur prev cword
  if [ -n "$BASH_VERSION" ]; then
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    cword=$COMP_CWORD
  fi

  local commands="start up stop down restart status ps logs log open ui clean prune alias autostart disable-autostart install-dokploy completion version help -h --help -v --version"

  if [ "$cword" -eq 1 ]; then
    COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
    return 0
  fi

  case "${COMP_WORDS[1]}" in
    start|up|stop|down|restart)
      COMPREPLY=( $(compgen -W "--core -c" -- "$cur") )
      ;;
    logs|log)
      if [ "$cword" -eq 2 ]; then
        local targets="panel db traefik -f --follow -n --tail"
        COMPREPLY=( $(compgen -W "$targets" -- "$cur") )
      else
        COMPREPLY=( $(compgen -W "-f --follow -n --tail" -- "$cur") )
      fi
      ;;
    clean|prune)
      COMPREPLY=( $(compgen -W "--force -f --all -a" -- "$cur") )
      ;;
    alias)
      COMPREPLY=( $(compgen -W "add set list" -- "$cur") )
      ;;
    autostart)
      COMPREPLY=( $(compgen -W "status disable enable" -- "$cur") )
      ;;
    completion)
      COMPREPLY=( $(compgen -W "bash zsh" -- "$cur") )
      ;;
  esac
}
EOF
  echo "complete -F _dokploy_completion dok dk dokploy $CMD_NAME $CLI_NAME"
}

generate_zsh_completion() {
  cat << 'EOF'
#compdef dok dk dokploy
_dokploy_zsh() {
  local -a subcommands
  subcommands=(
    'start:Start Dokploy core services and Traefik'
    'up:Start Dokploy core services and Traefik'
    'stop:Stop Dokploy services and user applications'
    'down:Stop Dokploy services and user applications'
    'restart:Restart Dokploy services'
    'status:Show status of Dokploy services & containers'
    'ps:Show status of Dokploy services & containers'
    'logs:View Dokploy or service logs'
    'open:Open Dokploy dashboard in browser'
    'clean:Prune unused Docker containers and build cache'
    'alias:Manage command aliases (e.g. dok, dk)'
    'install-dokploy:Install Dokploy and disable boot auto-startup'
    'disable-autostart:Disable Dokploy & Traefik auto-startup on boot'
    'autostart:Manage boot auto-startup (status, disable, enable)'
    'completion:Output shell completion script'
    'version:Show version information'
    'help:Show this help menu'
  )

  if (( CURRENT == 2 )); then
    _describe 'command' subcommands
  elif (( CURRENT == 3 )); then
    case "$words[2]" in
      start|up|stop|down|restart)
        _values 'options' \
          '--core[Target only Dokploy core services (panel & db)]' \
          '-c[Target only Dokploy core services (panel & db)]'
        ;;
      logs|log)
        local -a targets
        targets=(
          'panel:Dokploy web panel logs'
          'db:Dokploy PostgreSQL database logs'
          'traefik:Traefik reverse proxy logs'
          '-f:Follow log output'
          '--follow:Follow log output'
          '-n:Number of lines to show from the end'
        )
        _describe 'log target' targets
        ;;
      clean|prune)
        _values 'clean options' \
          '--force[Skip confirmation prompt]' \
          '-f[Skip confirmation prompt]' \
          '--all[Also clean build cache]' \
          '-a[Also clean build cache]'
        ;;
      alias)
        _values 'alias action' 'add' 'set' 'list'
        ;;
      autostart)
        _values 'autostart action' 'status' 'disable' 'enable'
        ;;
      completion)
        _values 'shell' 'bash' 'zsh'
        ;;
    esac
  fi
}
compdef _dokploy_zsh dok dk dokploy 2>/dev/null || true
EOF
  echo "compdef _dokploy_zsh $CMD_NAME $CLI_NAME 2>/dev/null || true"
}

# ------------------------------------------------------------------------------
# Version
# ------------------------------------------------------------------------------
show_version() {
  echo -e "${BOLD}Dokploy Local CLI:${NC} v${VERSION}"
  echo -e "Command alias:      ${CYAN}${CMD_NAME}${NC}"
  check_docker 2>/dev/null || true
  if [ -n "$DOCKER_BIN" ]; then
    local dok_img
    dok_img=$(get_dokploy_image)
    echo -e "Dokploy Image:      ${BOLD}${dok_img}${NC}"
  fi
}

# ------------------------------------------------------------------------------
# Command Routing
# ------------------------------------------------------------------------------
case "${1:-}" in
  start|up)
    start_dokploy "${2:-}"
    ;;
  stop|down)
    stop_dokploy "${2:-}"
    ;;
  restart)
    stop_dokploy "${2:-}"
    sleep 1
    start_dokploy "${2:-}"
    ;;
  status|ps)
    status_dokploy
    ;;
  logs|log)
    shift
    logs_dokploy "$@"
    ;;
  open|ui|dashboard)
    open_dashboard
    ;;
  clean|prune)
    shift
    clean_dokploy "$@"
    ;;
  alias)
    shift
    manage_alias "$@"
    ;;
  install-dokploy|setup-dokploy)
    install_dokploy
    ;;
  disable-autostart)
    disable_autostart_dokploy
    ;;
  autostart)
    shift
    manage_autostart "$@"
    ;;
  uninstall)
    shift
    uninstall_cli "$@"
    ;;
  completion)
    case "${2:-bash}" in
      zsh) generate_zsh_completion ;;
      *) generate_bash_completion ;;
    esac
    ;;
  -v|--version|version)
    show_version
    ;;
  -h|--help|help|"")
    show_help
    ;;
  *)
    echo -e "${RED}Unknown command:${NC} '$1'" >&2
    echo -e "Run ${CYAN}${CMD_NAME} --help${NC} for available commands." >&2
    exit 1
    ;;
esac
