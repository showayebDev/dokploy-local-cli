#!/usr/bin/env bash
# ==============================================================================
# Dokploy Local CLI Manager
# A fast, portable CLI tool to manage Dokploy local development on any Linux system.
# Works across all Linux distributions (Ubuntu, Debian, Fedora, Arch, Alpine, etc.)
# ==============================================================================
#
# CONFIGURATION VARIABLE: Choose Command Word / Prefix
# Change DEFAULT_CLI_NAME to choose what word starts your commands:
# Examples: "dok" (dok start), "dk" (dk start), "dokploy" (dokploy start)
#
# You can also override this by:
#   1. Setting CLI_NAME in your environment: export CLI_NAME="dk"
#   2. Setting CLI_NAME in ~/.config/dokploy-cli/config
#   3. Executing via symlink/alias (automatically detected at runtime)
# ==============================================================================
DEFAULT_CLI_NAME="dok"

set -e

VERSION="1.0.0"

# User configuration paths
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/dokploy-cli"
CONFIG_FILE="$CONFIG_DIR/config"
STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/dokploy"

# Load config file if present
if [ -f "$CONFIG_FILE" ]; then
  # shellcheck source=/dev/null
  . "$CONFIG_FILE"
fi

# Active command name configuration
CLI_NAME="${DOKPLOY_CLI_NAME:-${CLI_NAME:-$DEFAULT_CLI_NAME}}"

# Dynamic invocation name detection
INVOKED_AS="$(basename "$0" 2>/dev/null || echo "$CLI_NAME")"
if [ "$INVOKED_AS" = "bash" ] || [ "$INVOKED_AS" = "sh" ] || [ -z "$INVOKED_AS" ]; then
  CMD_NAME="$CLI_NAME"
else
  CMD_NAME="$INVOKED_AS"
fi

# Dokploy defaults
DOKPLOY_PORT="${DOKPLOY_PORT:-3000}"
DOKPLOY_NETWORK="${DOKPLOY_NETWORK:-dokploy-network}"
SVC_STATE="$STATE_DIR/stopped_services.txt"
CONT_STATE="$STATE_DIR/stopped_containers.txt"

# ------------------------------------------------------------------------------
# Terminal Colors & Formatting (Auto-detects TTY and respects NO_COLOR)
# ------------------------------------------------------------------------------
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  BOLD=$'\033[1m'
  DIM=$'\033[2m'
  GREEN=$'\033[0;32m'
  YELLOW=$'\033[1;33m'
  RED=$'\033[0;31m'
  CYAN=$'\033[0;36m'
  BLUE=$'\033[0;34m'
  MAGENTA=$'\033[0;35m'
  NC=$'\033[0m' # No Color
else
  BOLD=""
  DIM=""
  GREEN=""
  YELLOW=""
  RED=""
  CYAN=""
  BLUE=""
  MAGENTA=""
  NC=""
fi

# ------------------------------------------------------------------------------
# Helper Functions
# ------------------------------------------------------------------------------
ensure_state_dir() {
  mkdir -p "$STATE_DIR"
}

DOCKER_BIN=""
check_docker() {
  if command -v docker >/dev/null 2>&1; then
    DOCKER_BIN="docker"
  else
    echo -e "${RED}Error:${NC} 'docker' is not installed or not in your PATH." >&2
    echo "Please install Docker first: https://docs.docker.com/engine/install/" >&2
    exit 1
  fi

  if ! $DOCKER_BIN info >/dev/null 2>&1; then
    if command -v sudo >/dev/null 2>&1 && sudo -n docker info >/dev/null 2>&1; then
      DOCKER_BIN="sudo docker"
    else
      echo -e "${RED}Error:${NC} Cannot connect to the Docker daemon." >&2
      echo -e "Make sure Docker service is active and your user has permissions:" >&2
      echo -e "  1. Start Docker:  ${CYAN}sudo systemctl start docker${NC} (or ${CYAN}sudo service docker start${NC})" >&2
      echo -e "  2. User group:    ${CYAN}sudo usermod -aG docker \$USER${NC} (log out & back in)" >&2
      exit 1
    fi
  fi
}

get_dokploy_net_id() {
  $DOCKER_BIN network inspect "$DOKPLOY_NETWORK" --format '{{.Id}}' 2>/dev/null || true
}

get_dokploy_image() {
  $DOCKER_BIN service inspect dokploy --format '{{.Spec.TaskTemplate.ContainerSpec.Image}}' 2>/dev/null || echo "dokploy/dokploy"
}

