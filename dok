# ------------------------------------------------------------------------------
# Version
# ------------------------------------------------------------------------------
show_version() {
  echo -e "${BOLD}Dokploy Local CLI:${NC} v${VERSION}"
  echo -e "Command alias:      ${CYAN}${CMD_NAME}${NC}"
  echo -e "Platform:           ${GREEN}${OS_NAME}${NC}"
  check_docker 2>/dev/null || true
  if [ -n "$ENGINE_NAME" ]; then
    echo -e "Container Engine:   ${GREEN}${ENGINE_NAME}${NC}"
  fi
  if [ -n "$DOCKER_BIN" ]; then
    local dok_img
    dok_img=$(get_dokploy_image)
    echo -e "Dokploy Image:      ${BOLD}${dok_img}${NC}"
  fi
}

# ------------------------------------------------------------------------------
# Command Routing
# ------------------------------------------------------------------------------
case "${1:-}" in
  start|up)
    start_dokploy "${2:-}"
    ;;
  stop|down)
    stop_dokploy "${2:-}"
    ;;
  restart)
    stop_dokploy "${2:-}"
    sleep 1
    start_dokploy "${2:-}"
    ;;
  status|ps)
    status_dokploy
    ;;
  logs|log)
    shift
    logs_dokploy "$@"
    ;;
  open|ui|dashboard)
    open_dashboard
    ;;
  clean|prune)
    shift
    clean_dokploy "$@"
    ;;
  reset)
    shift
    reset_dokploy "$@"
    ;;
  alias)
    shift
    manage_alias "$@"
    ;;
  engine)
    shift
    manage_engine "$@"
    ;;
  install-dokploy|setup-dokploy)
    install_dokploy
    ;;
  disable-autostart)
    disable_autostart_dokploy
    ;;
  autostart)
    shift
    manage_autostart "$@"
    ;;
  update|upgrade)
    shift
    update_cli "$@"
    ;;
  uninstall)
    shift
    uninstall_cli "$@"
    ;;
  completion)
    case "${2:-bash}" in
      zsh) generate_zsh_completion ;;
      *) generate_bash_completion ;;
    esac
    ;;
  -v|--version|version)
    show_version
    ;;
  -h|--help|help|"")
    show_help
    ;;
  *)
    echo -e "${RED}Unknown command:${NC} '$1'" >&2
    echo -e "Run ${CYAN}${CMD_NAME} --help${NC} for available commands." >&2
    exit 1
    ;;
esac
