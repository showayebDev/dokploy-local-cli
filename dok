#!/usr/bin/env bash
# ==============================================================================
# Dokploy Local CLI Manager
# A fast, portable CLI tool to manage Dokploy local development.
# Works across all platforms: Linux, macOS, and Windows.
# Supports Docker, Podman, and Kiri container runtimes.
# ==============================================================================
# Prevent Git Bash / MSYS on Windows from auto-converting Unix paths
export MSYS_NO_PATHCONV=1

# CONFIGURATION VARIABLE: Choose Command Word / Prefix
# Change DEFAULT_CLI_NAME to choose what word starts your commands:
# Examples: "dok" (dok start), "dk" (dk start), "dokploy" (dokploy start)
#
# You can also override this by:
#   1. Setting CLI_NAME in your environment: export CLI_NAME="dk"
#   2. Setting CLI_NAME in ~/.config/dokploy-cli/config
#   3. Executing via symlink/alias (automatically detected at runtime)
# ==============================================================================
DEFAULT_CLI_NAME="dok"

set -e

VERSION="1.2.0"
GITHUB_REPO="${GITHUB_REPO:-showayebDev/dokploy-local-cli}"
GITHUB_BRANCH="${GITHUB_BRANCH:-main}"

# ------------------------------------------------------------------------------
# OS Platform Detection (Linux, macOS, Windows)
# ------------------------------------------------------------------------------
OS_TYPE=""
OS_NAME=""
detect_os() {
  if [ -n "$OS_TYPE" ]; then
    return 0
  fi
  case "$(uname -s 2>/dev/null || echo "")" in
    Darwin*)
      OS_TYPE="macos"
      OS_NAME="macOS"
      ;;
    Linux*)
      if grep -qi "microsoft" /proc/version 2>/dev/null || [ -n "${WSL_DISTRO_NAME:-}" ]; then
        OS_TYPE="wsl"
        OS_NAME="Linux (WSL)"
      else
        OS_TYPE="linux"
        OS_NAME="Linux"
      fi
      ;;
    MINGW*|MSYS*|CYGWIN*)
      OS_TYPE="windows"
      OS_NAME="Windows"
      ;;
    *)
      if command -v cmd.exe >/dev/null 2>&1 || command -v powershell.exe >/dev/null 2>&1; then
        OS_TYPE="windows"
        OS_NAME="Windows"
      else
        OS_TYPE="unix"
        OS_NAME="$(uname -s 2>/dev/null || echo 'Unix')"
      fi
      ;;
  esac
}
detect_os

# ------------------------------------------------------------------------------
# Cross-Platform Helpers (macOS BSD vs Linux GNU compatibility)
# ------------------------------------------------------------------------------
# Cross-platform in-place sed (compatible with macOS BSD sed and Linux GNU sed)
sed_inplace() {
  local expr="$1"
  local file="$2"
  if [ ! -f "$file" ]; then
    return 0
  fi
  sed -i.dokbak "$expr" "$file" 2>/dev/null && rm -f "${file}.dokbak" 2>/dev/null || true
}

# Cross-platform secret generator (supports macOS, Linux, and Windows Git Bash)
generate_random_secret() {
  local length="${1:-32}"
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex "$((length / 2))" 2>/dev/null
  elif [ -r /dev/urandom ]; then
    LC_ALL=C tr -dc 'a-zA-Z0-9' < /dev/urandom 2>/dev/null | head -c "$length"
  else
    local seed="$RANDOM$(date +%s)$$${HOSTNAME:-}"
    if command -v sha256sum >/dev/null 2>&1; then
      echo "$seed" | sha256sum | awk '{print $1}' | head -c "$length"
    elif command -v shasum >/dev/null 2>&1; then
      echo "$seed" | shasum -a 256 | awk '{print $1}' | head -c "$length"
    else
      echo "dokploy_secret_${RANDOM}_$(date +%s)" | head -c "$length"
    fi
  fi
}

# Cross-platform binary path resolver (replaces readlink -f for macOS compatibility)
resolve_script_path() {
  local target="$1"
  local resolved
  resolved="$(readlink -f "$target" 2>/dev/null || realpath "$target" 2>/dev/null || echo "")"
  if [ -n "$resolved" ] && [ -f "$resolved" ]; then
    echo "$resolved"
    return 0
  fi
  while [ -L "$target" ]; do
    local dir
    dir="$(cd -P "$(dirname "$target")" && pwd)"
    target="$(readlink "$target")"
    [[ $target != /* ]] && target="$dir/$target"
  done
  echo "$(cd -P "$(dirname "$target")" && pwd)/$(basename "$target")"
}

# User configuration paths
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/dokploy-cli"
CONFIG_FILE="$CONFIG_DIR/config"
STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/dokploy"

# Load config file if present
if [ -f "$CONFIG_FILE" ]; then
  # shellcheck source=/dev/null
  . "$CONFIG_FILE"
fi

# Active command name configuration
CLI_NAME="${DOKPLOY_CLI_NAME:-${CLI_NAME:-$DEFAULT_CLI_NAME}}"

# Dynamic invocation name detection
INVOKED_AS="$(basename "$0" 2>/dev/null || echo "$CLI_NAME")"
if [ "$INVOKED_AS" = "bash" ] || [ "$INVOKED_AS" = "sh" ] || [ -z "$INVOKED_AS" ]; then
  CMD_NAME="$CLI_NAME"
else
  CMD_NAME="$INVOKED_AS"
fi

# Dokploy defaults
DOKPLOY_PORT="${DOKPLOY_PORT:-3000}"
DOKPLOY_NETWORK="${DOKPLOY_NETWORK:-dokploy-network}"
SVC_STATE="$STATE_DIR/stopped_services.txt"
CONT_STATE="$STATE_DIR/stopped_containers.txt"

# ------------------------------------------------------------------------------
# Terminal Colors & Formatting (Auto-detects TTY and respects NO_COLOR)
# ------------------------------------------------------------------------------
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  BOLD=$'\033[1m'
  DIM=$'\033[2m'
  GREEN=$'\033[0;32m'
  YELLOW=$'\033[1;33m'
  RED=$'\033[0;31m'
  CYAN=$'\033[0;36m'
  BLUE=$'\033[0;34m'
  MAGENTA=$'\033[0;35m'
  NC=$'\033[0m' # No Color
else
  BOLD=""
  DIM=""
  GREEN=""
  YELLOW=""
  RED=""
  CYAN=""
  BLUE=""
  MAGENTA=""
  NC=""
fi

# ------------------------------------------------------------------------------
# Helper Functions
# ------------------------------------------------------------------------------
# Container Engine Abstraction (Docker, Podman, Kiri)
# ------------------------------------------------------------------------------
ensure_state_dir() {
  mkdir -p "$STATE_DIR"
}

CONTAINER_ENGINE="${CONTAINER_ENGINE:-${DOK_ENGINE:-auto}}"
ENGINE_BIN=""
ENGINE_TYPE=""
ENGINE_NAME=""
ENGINE_SOCK="/var/run/docker.sock"
DOCKER_BIN=""

test_engine_bin() {
  local b="$1"
  if command -v "$b" >/dev/null 2>&1; then
    if "$b" info >/dev/null 2>&1; then
      return 0
    fi
    if command -v sudo >/dev/null 2>&1 && sudo -n "$b" info >/dev/null 2>&1; then
      return 0
    fi
  fi
  return 1
}

detect_engine() {
  # Avoid re-detecting if already resolved in this session
  if [ -n "$ENGINE_BIN" ]; then
    return 0
  fi

  local preferred="$CONTAINER_ENGINE"
  if [ "$preferred" = "auto" ] && [ -n "${DOKPLOY_ENGINE:-}" ]; then
    preferred="$DOKPLOY_ENGINE"
  fi

  # Explicit override requested
  if [ -n "$preferred" ] && [ "$preferred" != "auto" ]; then
    case "$preferred" in
      podman)
        if test_engine_bin podman; then
          ENGINE_BIN="podman"
          ENGINE_TYPE="podman"
          ENGINE_NAME="Podman"
        else
          echo -e "${RED}Error:${NC} Configured engine 'podman' is not available or daemon is not running." >&2
          exit 1
        fi
        ;;
      kiri)
        if test_engine_bin docker && (docker context show 2>/dev/null | grep -qi "kiri" || docker info --format '{{.OperatingSystem}}' 2>/dev/null | grep -qi "kiri"); then
          ENGINE_BIN="docker"
          ENGINE_TYPE="kiri"
          ENGINE_NAME="Kiri Container Runtime"
        elif test_engine_bin kiri; then
          ENGINE_BIN="kiri"
          ENGINE_TYPE="kiri"
          ENGINE_NAME="Kiri"
        else
          echo -e "${RED}Error:${NC} Configured engine 'kiri' is not active or running." >&2
          exit 1
        fi
        ;;
      nerdctl)
        if test_engine_bin nerdctl; then
          ENGINE_BIN="nerdctl"
          ENGINE_TYPE="nerdctl"
          ENGINE_NAME="Nerdctl (containerd)"
        else
          echo -e "${RED}Error:${NC} Configured engine 'nerdctl' is not available or daemon is not running." >&2
          exit 1
        fi
        ;;
      docker)
        if test_engine_bin docker; then
          ENGINE_BIN="docker"
          if docker info --format '{{.OperatingSystem}}' 2>/dev/null | grep -qi "kiri" || docker context show 2>/dev/null | grep -qi "kiri"; then
            ENGINE_TYPE="kiri"
            ENGINE_NAME="Kiri (via docker context)"
          elif [ "$(docker info --format '{{.Swarm.LocalNodeState}}' 2>/dev/null)" = "active" ]; then
            ENGINE_TYPE="docker"
            ENGINE_NAME="Docker (Swarm Mode)"
          else
            ENGINE_TYPE="docker"
            ENGINE_NAME="Docker (Standalone Mode)"
          fi
        else
          echo -e "${RED}Error:${NC} Configured engine 'docker' is not available or daemon is not running." >&2
          exit 1
        fi
        ;;
      *)
        if test_engine_bin "$preferred"; then
          ENGINE_BIN="$preferred"
          ENGINE_TYPE="$preferred"
          ENGINE_NAME="$preferred"
        fi
        ;;
    esac
  fi

  # Auto-detect engine if not yet determined
  if [ -z "$ENGINE_BIN" ]; then
    if test_engine_bin docker; then
      ENGINE_BIN="docker"
      local os_info ctx_info
      os_info=$(docker info --format '{{.OperatingSystem}}' 2>/dev/null || echo "")
      ctx_info=$(docker context show 2>/dev/null || echo "")
      if echo "$os_info $ctx_info" | grep -qi "kiri"; then
        ENGINE_TYPE="kiri"
        ENGINE_NAME="Kiri Container Runtime"
      elif [ "$(docker info --format '{{.Swarm.LocalNodeState}}' 2>/dev/null)" = "active" ]; then
        ENGINE_TYPE="docker"
        ENGINE_NAME="Docker (Swarm Mode)"
      else
        ENGINE_TYPE="docker"
        ENGINE_NAME="Docker (Standalone Mode)"
      fi
    elif test_engine_bin podman; then
      ENGINE_BIN="podman"
      ENGINE_TYPE="podman"
      ENGINE_NAME="Podman"
    elif test_engine_bin kiri; then
      ENGINE_BIN="kiri"
      ENGINE_TYPE="kiri"
      ENGINE_NAME="Kiri"
    elif test_engine_bin nerdctl; then
      ENGINE_BIN="nerdctl"
      ENGINE_TYPE="nerdctl"
      ENGINE_NAME="Nerdctl (containerd)"
    else
      echo -e "${RED}Error:${NC} No supported container engine found (Docker, Podman, Kiri, or Nerdctl)." >&2
      echo -e "Please ensure Docker, Podman, Kiri, or Nerdctl is installed and active in your PATH." >&2
      exit 1
    fi
  fi

  # Check root/sudo permissions for engine binary if required
  if ! $ENGINE_BIN info >/dev/null 2>&1; then
    if command -v sudo >/dev/null 2>&1 && sudo -n $ENGINE_BIN info >/dev/null 2>&1; then
      ENGINE_BIN="sudo $ENGINE_BIN"
    fi
  fi

  # Resolve socket path for Dokploy container bind mount across Linux, macOS, and Windows
  if [ "$ENGINE_TYPE" = "podman" ]; then
    if [ -S "/run/podman/podman.sock" ]; then
      ENGINE_SOCK="/run/podman/podman.sock"
    elif [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -S "$XDG_RUNTIME_DIR/podman/podman.sock" ]; then
      ENGINE_SOCK="$XDG_RUNTIME_DIR/podman/podman.sock"
    elif [ -S "/run/user/$(id -u 2>/dev/null || echo 1000)/podman/podman.sock" ]; then
      ENGINE_SOCK="/run/user/$(id -u 2>/dev/null || echo 1000)/podman/podman.sock"
    elif [ -S "$HOME/.local/share/containers/podman/machine/podman.sock" ]; then
      ENGINE_SOCK="$HOME/.local/share/containers/podman/machine/podman.sock"
    else
      ENGINE_SOCK="/var/run/docker.sock"
    fi
  else
    if [ -S "/var/run/docker.sock" ]; then
      ENGINE_SOCK="/var/run/docker.sock"
    elif [ -S "$HOME/.docker/run/docker.sock" ]; then
      ENGINE_SOCK="$HOME/.docker/run/docker.sock"
    elif [ -S "$HOME/.colima/default/docker.sock" ]; then
      ENGINE_SOCK="$HOME/.colima/default/docker.sock"
    else
      ENGINE_SOCK="/var/run/docker.sock"
    fi
  fi

  DOCKER_BIN="$ENGINE_BIN"
}

check_docker() {
  detect_engine
}

get_dokploy_net_id() {
  $DOCKER_BIN network inspect "$DOKPLOY_NETWORK" --format '{{.Id}}' 2>/dev/null || true
}

get_dokploy_image() {
  $DOCKER_BIN service inspect dokploy --format '{{.Spec.TaskTemplate.ContainerSpec.Image}}' 2>/dev/null || echo "dokploy/dokploy"
}

