# ------------------------------------------------------------------------------
# Core Actions: start, stop, restart, status
# ------------------------------------------------------------------------------
is_swarm_available() {
  [ "$ENGINE_TYPE" = "docker" ] || return 1
  local swarm_state
  swarm_state=$($DOCKER_BIN info --format '{{.Swarm.LocalNodeState}}' 2>/dev/null || echo "inactive")
  [ "$swarm_state" = "active" ]
}

install_dokploy_standalone() {
  echo -e "${BOLD}[${CMD_NAME}]${NC} Initializing Dokploy for local development on ${ENGINE_NAME}..."

  local sec_opts=()
  if [ "$ENGINE_TYPE" = "podman" ]; then
    sec_opts=(--security-opt label=disable)
  fi

  # Create bridge network
  $DOCKER_BIN network create "$DOKPLOY_NETWORK" 2>/dev/null || true

  # Start postgres
  if ! $DOCKER_BIN inspect dokploy-postgres >/dev/null 2>&1; then
    echo -e "  ${CYAN}->${NC} Creating dokploy-postgres database container..."
    $DOCKER_BIN run -d \
      --name dokploy-postgres \
      --network "$DOKPLOY_NETWORK" \
      --restart unless-stopped \
      "${sec_opts[@]}" \
      -e POSTGRES_USER=dokploy \
      -e POSTGRES_DB=dokploy \
      -e POSTGRES_PASSWORD=dokploypassword \
      -v dokploy-postgres-data:/var/lib/postgresql/data \
      postgres:16 || true
  else
    $DOCKER_BIN start dokploy-postgres >/dev/null 2>&1 || true
  fi

  # Start dokploy
  if ! $DOCKER_BIN inspect dokploy >/dev/null 2>&1; then
    echo -e "  ${CYAN}->${NC} Creating dokploy web dashboard container..."
    $DOCKER_BIN run -d \
      --name dokploy \
      --network "$DOKPLOY_NETWORK" \
      --restart unless-stopped \
      "${sec_opts[@]}" \
      -p "${DOKPLOY_PORT}:3000" \
      -v "${ENGINE_SOCK}:/var/run/docker.sock" \
      -v dokploy-data:/etc/dokploy \
      -e DATABASE_URL="postgres://dokploy:dokploypassword@dokploy-postgres:5432/dokploy" \
      -e BETTER_AUTH_SECRET="a8f9c73e1b6408259dfc97284b8109d732890471b69482035816901842857189" \
      dokploy/dokploy:latest || true
  else
    $DOCKER_BIN start dokploy >/dev/null 2>&1 || true
  fi

  # Start traefik
  if ! $DOCKER_BIN inspect dokploy-traefik >/dev/null 2>&1; then
    echo -e "  ${CYAN}->${NC} Creating dokploy-traefik proxy container..."
    $DOCKER_BIN run -d \
      --name dokploy-traefik \
      --network "$DOKPLOY_NETWORK" \
      --restart unless-stopped \
      "${sec_opts[@]}" \
      -p 80:80 \
      -p 443:443 \
      -v "${ENGINE_SOCK}:/var/run/docker.sock:ro" \
      -v dokploy-data:/etc/dokploy \
      traefik:v3.1 \
      --configFile=/etc/dokploy/traefik/traefik.yml || true
  else
    $DOCKER_BIN start dokploy-traefik >/dev/null 2>&1 || true
  fi

  echo -e "\n${GREEN}✔ Dokploy successfully initialized on ${ENGINE_NAME}!${NC}"
  echo -e "  Dashboard: ${CYAN}${BOLD}http://localhost:${DOKPLOY_PORT}${NC}"
}

start_dokploy() {
  local mode="$1"
  check_docker

  if is_swarm_available; then
    # Swarm mode
    if ! $DOCKER_BIN service inspect dokploy >/dev/null 2>&1; then
      echo -e "${YELLOW}Notice:${NC} Core service '${BOLD}dokploy${NC}' is not found in Docker Swarm."
      echo -e "An image is downloaded, but the Swarm service has not been created yet."
      echo ""
      read -r -p "Would you like to initialize/create Dokploy services now? [Y/n]: " setup_choice
      case "$setup_choice" in
        [nN][oO]|[nN])
          echo -e "Aborted. You can run ${CYAN}${BOLD}${CMD_NAME} install-dokploy${NC} when ready."
          return 1
          ;;
        *)
          install_dokploy
          return 0
          ;;
      esac
    fi

    echo -e "${BOLD}[${CMD_NAME}]${NC} Starting core Dokploy services (Swarm)..."
    $DOCKER_BIN service scale dokploy=1 dokploy-postgres=1
    if ! $DOCKER_BIN start dokploy-traefik >/dev/null 2>&1; then
      $DOCKER_BIN network disconnect -f dokploy-network dokploy-traefik >/dev/null 2>&1 || true
      $DOCKER_BIN network connect dokploy-network dokploy-traefik >/dev/null 2>&1 || true
      $DOCKER_BIN start dokploy-traefik >/dev/null 2>&1 || true
    fi
  else
    # Standalone Container Mode (Kiri / Podman / Docker Standalone)
    if ! $DOCKER_BIN inspect dokploy >/dev/null 2>&1; then
      echo -e "${YELLOW}Notice:${NC} Dokploy container is not yet initialized on ${ENGINE_NAME}."
      read -r -p "Would you like to initialize Dokploy now? [Y/n]: " setup_choice
      case "$setup_choice" in
        [nN][oO]|[nN])
          echo -e "Aborted. You can run ${CYAN}${BOLD}${CMD_NAME} install-dokploy${NC} when ready."
          return 1
          ;;
        *)
          install_dokploy_standalone
          return 0
          ;;
      esac
    fi

    echo -e "${BOLD}[${CMD_NAME}]${NC} Starting Dokploy core containers (${ENGINE_NAME})..."
    $DOCKER_BIN start dokploy-postgres dokploy >/dev/null 2>&1 || true
    # Strip swarm provider from traefik.yml for standalone engines (Kiri / Podman)
    $DOCKER_BIN exec dokploy sed -i '/swarm:/,/watch:/d' /etc/dokploy/traefik/traefik.yml 2>/dev/null || true
    if [ "$mode" != "--core" ] && [ "$mode" != "-c" ]; then
      $DOCKER_BIN start dokploy-traefik >/dev/null 2>&1 || true
    fi
  fi

  if [ "$mode" != "--core" ] && [ "$mode" != "-c" ]; then
    if [ -f "$SVC_STATE" ] && [ -s "$SVC_STATE" ]; then
      echo -e "${BOLD}[${CMD_NAME}]${NC} Restoring previously active Dokploy apps/services..."
      while IFS='=' read -r svc_name replicas; do
        if [ -n "$svc_name" ] && [ -n "$replicas" ]; then
          echo -e "  ${GREEN}->${NC} Restoring service: ${BOLD}$svc_name${NC} (replicas: $replicas)"
          $DOCKER_BIN service scale "$svc_name=$replicas" >/dev/null 2>&1 || true
        fi
      done < "$SVC_STATE"
      rm -f "$SVC_STATE"
    fi

    if [ -f "$CONT_STATE" ] && [ -s "$CONT_STATE" ]; then
      echo -e "${BOLD}[${CMD_NAME}]${NC} Restoring previously active Dokploy containers..."
      while IFS= read -r c_id; do
        if [ -n "$c_id" ]; then
          echo -e "  ${GREEN}->${NC} Starting container: ${BOLD}$c_id${NC}"
          $DOCKER_BIN start "$c_id" >/dev/null 2>&1 || true
        fi
      done < "$CONT_STATE"
      rm -f "$CONT_STATE"
    fi
  else
    echo -e "${DIM}Core mode: skipped restoring user services.${NC}"
  fi

  echo -e "${GREEN}✔${NC} Dokploy started successfully!"
  echo -e "  Dashboard: ${CYAN}${BOLD}http://localhost:${DOKPLOY_PORT}${NC}"
  echo -e "  Run ${DIM}'${CMD_NAME} status'${NC} to view running services."
}

stop_dokploy() {
  local mode="$1"
  check_docker

  if is_swarm_available; then
    # If --core, only stop dokploy and dokploy-postgres
    if [ "$mode" = "--core" ] || [ "$mode" = "-c" ]; then
      echo -e "${BOLD}[${CMD_NAME}]${NC} Stopping only Dokploy core services..."
      $DOCKER_BIN service scale dokploy=0 dokploy-postgres=0
      echo -e "${YELLOW}✔${NC} Dokploy core stopped. User applications and Traefik remain running."
      return 0
    fi

    # Without --core: Stop ALL (user apps + dokploy + dokploy-postgres + dokploy-traefik)
    ensure_state_dir
    > "$SVC_STATE"
    > "$CONT_STATE"

    echo -e "${BOLD}[${CMD_NAME}]${NC} Scanning for active Dokploy user applications..."
    local net_id
    net_id=$(get_dokploy_net_id)

    if [ -n "$net_id" ]; then
      for s_id in $($DOCKER_BIN service ls -q 2>/dev/null); do
        local name
        name=$($DOCKER_BIN service inspect --format '{{.Spec.Name}}' "$s_id" 2>/dev/null)
        if [ "$name" = "dokploy" ] || [ "$name" = "dokploy-postgres" ]; then
          continue
        fi

        local is_on_net
        is_on_net=$($DOCKER_BIN service inspect --format '{{range .Spec.TaskTemplate.Networks}}{{.Target}} {{end}}' "$s_id" 2>/dev/null | grep -w "$net_id" || true)
        if [ -n "$is_on_net" ]; then
          local replicas
          replicas=$($DOCKER_BIN service inspect --format '{{if .Spec.Mode.Replicated}}{{.Spec.Mode.Replicated.Replicas}}{{else}}0{{end}}' "$s_id" 2>/dev/null)
          if [ "$replicas" -gt 0 ]; then
            echo -e "  ${YELLOW}->${NC} Stopping service: ${BOLD}$name${NC} (was $replicas replicas)"
            echo "$name=$replicas" >> "$SVC_STATE"
            $DOCKER_BIN service scale "$name=0" >/dev/null 2>&1 || true
          fi
        fi
      done

      $DOCKER_BIN ps --filter "network=$DOKPLOY_NETWORK" --format '{{.ID}} {{.Names}} {{.Label "com.docker.swarm.service.name"}}' 2>/dev/null | while IFS= read -r line; do
        [ -z "$line" ] && continue
        local c_id c_name swarm_svc
        c_id=$(echo "$line" | awk '{print $1}')
        c_name=$(echo "$line" | awk '{print $2}')
        swarm_svc=$(echo "$line" | awk '{print $3}')

        if [ "$c_name" = "dokploy-traefik" ] || [ -n "$swarm_svc" ]; then
          continue
        fi

        echo -e "  ${YELLOW}->${NC} Stopping standalone container: ${BOLD}$c_name${NC} ($c_id)"
        echo "$c_id" >> "$CONT_STATE"
        $DOCKER_BIN stop "$c_id" >/dev/null 2>&1 || true
      done
    fi

    echo -e "${BOLD}[${CMD_NAME}]${NC} Stopping core Dokploy services..."
    $DOCKER_BIN service scale dokploy=0 dokploy-postgres=0
    $DOCKER_BIN stop dokploy-traefik >/dev/null 2>&1 || true

    echo -e "${GREEN}✔${NC} Dokploy and all associated applications stopped. CPU and RAM freed!"
  else
    # Standalone Container Mode (Kiri)
    if [ "$mode" = "--core" ] || [ "$mode" = "-c" ]; then
      echo -e "${BOLD}[${CMD_NAME}]${NC} Stopping only Dokploy core panel..."
      $DOCKER_BIN stop dokploy dokploy-postgres >/dev/null 2>&1 || true
      echo -e "${YELLOW}✔${NC} Dokploy core stopped. User applications and Traefik remain running."
      return 0
    fi

    ensure_state_dir
    > "$CONT_STATE"

    echo -e "${BOLD}[${CMD_NAME}]${NC} Scanning for active Dokploy user containers..."
    $DOCKER_BIN ps --filter "network=$DOKPLOY_NETWORK" --format '{{.ID}} {{.Names}}' 2>/dev/null | while IFS= read -r line; do
      [ -z "$line" ] && continue
      local c_id c_name
      c_id=$(echo "$line" | awk '{print $1}')
      c_name=$(echo "$line" | awk '{print $2}')

      if [ "$c_name" = "dokploy" ] || [ "$c_name" = "dokploy-postgres" ] || [ "$c_name" = "dokploy-traefik" ]; then
        continue
      fi

      echo -e "  ${YELLOW}->${NC} Stopping container: ${BOLD}$c_name${NC} ($c_id)"
      echo "$c_id" >> "$CONT_STATE"
      $DOCKER_BIN stop "$c_id" >/dev/null 2>&1 || true
    done

    echo -e "${BOLD}[${CMD_NAME}]${NC} Stopping Dokploy core containers..."
    $DOCKER_BIN stop dokploy dokploy-postgres dokploy-traefik >/dev/null 2>&1 || true
    echo -e "${GREEN}✔${NC} Dokploy and all associated applications stopped. CPU and RAM freed!"
  fi
}

status_dokploy() {
  check_docker

  echo -e "${BOLD}======================================================${NC}"
  echo -e "${BOLD} Dokploy Local Development Status  (${CYAN}${CMD_NAME}${NC}${BOLD})${NC}"
  echo -e "${BOLD}======================================================${NC}"
  echo -e "Platform:           ${GREEN}${OS_NAME}${NC}"
  echo -e "Container Engine:   ${GREEN}${ENGINE_NAME}${NC}"

  if is_swarm_available; then
    # Core Dokploy Swarm Services
    echo -e "\n${BOLD}${CYAN}Core Dokploy Services (Swarm):${NC}"
    $DOCKER_BIN service ls --filter "name=dokploy" --format "table {{.Name}}\t{{.Mode}}\t{{.Replicas}}\t{{.Image}}"

    # Dokploy Traefik
    echo -e "\n${BOLD}${CYAN}Dokploy Traefik Proxy:${NC}"
    $DOCKER_BIN ps -a --filter "name=dokploy-traefik" --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"

    # User Applications
    echo -e "\n${BOLD}${CYAN}Dokploy User Applications & Services:${NC}"
    local user_apps
    user_apps=$($DOCKER_BIN service ls --format "table {{.Name}}\t{{.Mode}}\t{{.Replicas}}\t{{.Image}}" 2>/dev/null | grep -v -E "^(dokploy|dokploy-postgres)[[:space:]]" || true)
    if [ -n "$user_apps" ]; then
      echo "$user_apps"
    else
      echo -e "${DIM}No user applications currently deployed.${NC}"
    fi

    # Check if core panel is running
    local panel_replicas
    panel_replicas=$($DOCKER_BIN service inspect dokploy --format '{{if .Spec.Mode.Replicated}}{{.Spec.Mode.Replicated.Replicas}}{{else}}0{{end}}' 2>/dev/null || echo "0")
    echo ""
    if [ "$panel_replicas" -gt 0 ]; then
      echo -e "${GREEN}●${NC} Dokploy Web Dashboard: ${CYAN}${BOLD}http://localhost:${DOKPLOY_PORT}${NC}"
    else
      echo -e "${YELLOW}○${NC} Dokploy is currently stopped. Run ${BOLD}'${CMD_NAME} start'${NC} to start."
    fi
  else
    # Standalone Container Mode (Kiri / Podman / Docker Standalone)
    echo -e "\n${BOLD}${CYAN}Engine Mode:${NC} ${GREEN}${ENGINE_NAME} (Standalone Mode)${NC}"

    echo -e "\n${BOLD}${CYAN}Core Dokploy Containers:${NC}"
    $DOCKER_BIN ps -a --filter "name=dokploy" --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"

    echo -e "\n${BOLD}${CYAN}Dokploy User Applications:${NC}"
    local user_apps
    user_apps=$($DOCKER_BIN ps -a --filter "network=$DOKPLOY_NETWORK" --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}" 2>/dev/null | grep -v -E "^(dokploy|dokploy-postgres|dokploy-traefik)[[:space:]]" || true)
    if [ -n "$user_apps" ]; then
      echo "$user_apps"
    else
      echo -e "${DIM}No user applications currently deployed on $DOKPLOY_NETWORK.${NC}"
    fi

    local is_running
    is_running=$($DOCKER_BIN inspect --format '{{.State.Running}}' dokploy 2>/dev/null || echo "false")
    echo ""
    if [ "$is_running" = "true" ]; then
      echo -e "${GREEN}●${NC} Dokploy Web Dashboard: ${CYAN}${BOLD}http://localhost:${DOKPLOY_PORT}${NC}"
    else
      echo -e "${YELLOW}○${NC} Dokploy is currently stopped. Run ${BOLD}'${CMD_NAME} start'${NC} to start."
    fi
  fi
}

# ------------------------------------------------------------------------------
# Logs Command
# ------------------------------------------------------------------------------
logs_dokploy() {
  check_docker
  local target="${1:-panel}"
  shift || true

  local extra_args=()
  while [ $# -gt 0 ]; do
    extra_args+=("$1")
    shift
  done

  case "$target" in
    panel|web|core)
      echo -e "${BOLD}[${CMD_NAME}]${NC} Logs for ${BOLD}dokploy${NC} web panel:"
      if is_swarm_available && $DOCKER_BIN service inspect dokploy >/dev/null 2>&1; then
        $DOCKER_BIN service logs "${extra_args[@]}" dokploy
      else
        $DOCKER_BIN logs "${extra_args[@]}" dokploy
      fi
      ;;
    db|postgres)
      echo -e "${BOLD}[${CMD_NAME}]${NC} Logs for ${BOLD}dokploy-postgres${NC} database:"
      if is_swarm_available && $DOCKER_BIN service inspect dokploy-postgres >/dev/null 2>&1; then
        $DOCKER_BIN service logs "${extra_args[@]}" dokploy-postgres
      else
        $DOCKER_BIN logs "${extra_args[@]}" dokploy-postgres
      fi
      ;;
    traefik|proxy)
      echo -e "${BOLD}[${CMD_NAME}]${NC} Logs for ${BOLD}dokploy-traefik${NC} reverse proxy:"
      $DOCKER_BIN logs "${extra_args[@]}" dokploy-traefik
      ;;
    *)
      # Check if matching Swarm service exists
      if $DOCKER_BIN service inspect "$target" >/dev/null 2>&1; then
        echo -e "${BOLD}[${CMD_NAME}]${NC} Logs for Swarm service: ${BOLD}$target${NC}"
        $DOCKER_BIN service logs "${extra_args[@]}" "$target"
      elif $DOCKER_BIN inspect "$target" >/dev/null 2>&1; then
        echo -e "${BOLD}[${CMD_NAME}]${NC} Logs for container: ${BOLD}$target${NC}"
        $DOCKER_BIN logs "${extra_args[@]}" "$target"
      else
        echo -e "${RED}Error:${NC} No Dokploy service or container named '${target}' found." >&2
        echo "Valid targets: panel, db, traefik, or any running service name." >&2
        exit 1
      fi
      ;;
  esac
}

# ------------------------------------------------------------------------------
# Open in Browser
# ------------------------------------------------------------------------------
open_dashboard() {
  local url="http://127.0.0.1:${DOKPLOY_PORT}"
  echo -e "${BOLD}[${CMD_NAME}]${NC} Opening Dokploy dashboard: ${CYAN}${url}${NC}"

  # 1. macOS native browser launcher
  if [ "$OS_TYPE" = "macos" ] || ( [ "$(uname -s 2>/dev/null)" = "Darwin" ] && command -v open >/dev/null 2>&1 ); then
    open "$url" >/dev/null 2>&1 &
    return 0
  fi

  # 2. Windows host browser launch support (Git Bash, MSYS2, WSL, CMD, PowerShell)
  if command -v explorer.exe >/dev/null 2>&1; then
    explorer.exe "$url" >/dev/null 2>&1 &
    return 0
  elif command -v cmd.exe >/dev/null 2>&1; then
    cmd.exe /c start "" "$url" >/dev/null 2>&1 &
    return 0
  elif command -v wslview >/dev/null 2>&1; then
    wslview "$url" >/dev/null 2>&1 &
    return 0
  fi

  # 3. Linux desktop browser launcher (X11 / Wayland)
  if [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ] || command -v xdg-open >/dev/null 2>&1; then
    if command -v xdg-open >/dev/null 2>&1; then
      xdg-open "$url" >/dev/null 2>&1 &
      return 0
    elif command -v sensible-browser >/dev/null 2>&1; then
      sensible-browser "$url" >/dev/null 2>&1 &
      return 0
    elif command -v x-www-browser >/dev/null 2>&1; then
      x-www-browser "$url" >/dev/null 2>&1 &
      return 0
    fi
  fi
  echo -e "Visit ${BOLD}${CYAN}${url}${NC} in your web browser."
}

# ------------------------------------------------------------------------------
# Clean & Prune Artifacts
# ------------------------------------------------------------------------------
clean_dokploy() {
  check_docker
  local force=false
  local prune_all=false

  for arg in "$@"; do
    case "$arg" in
      -f|--force) force=true ;;
      -a|--all) prune_all=true ;;
    esac
  done

  if [ "$force" = false ]; then
    echo -e "${YELLOW}Warning:${NC} This will prune stopped Docker containers and dangling images."
    read -r -p "Are you sure you want to proceed? [y/N]: " confirm
    case "$confirm" in
      [yY][eE][sS]|[yY]) ;;
      *) echo "Aborted."; return 0 ;;
    esac
  fi

  echo -e "${BOLD}[${CMD_NAME}]${NC} Pruning stopped containers..."
  $DOCKER_BIN container prune -f
  echo -e "${BOLD}[${CMD_NAME}]${NC} Pruning dangling images..."
  $DOCKER_BIN image prune -f

  if [ "$prune_all" = true ]; then
    echo -e "${BOLD}[${CMD_NAME}]${NC} Pruning build cache..."
    $DOCKER_BIN builder prune -f
  fi

  echo -e "${GREEN}✔${NC} Docker cleanup complete."
}

# ------------------------------------------------------------------------------
# Reset Dokploy (Complete Clean State)
# ------------------------------------------------------------------------------
reset_dokploy() {
  check_docker
  local force=false
  local hard=false

  while [ $# -gt 0 ]; do
    case "$1" in
      -f|--force|-y|--yes)
        force=true
        ;;
      --hard)
        hard=true
        ;;
      -h|--help)
        cat << EOF
Usage: ${CMD_NAME} reset [options]

Completely wipe Dokploy data, database, config, and containers for a clean restart.

Options:
  -f, --force, -y    Skip confirmation prompt
  --hard             Also remove all deployed user applications and networks
  -h, --help         Show this help message
EOF
        return 0
        ;;
    esac
    shift
  done

  if [ "$force" = false ]; then
    echo -e "${YELLOW}${BOLD}⚠️  WARNING: Dokploy Complete Reset${NC}"
    echo -e "This will permanently destroy:"
    echo -e "  ${RED}•${NC} Dokploy management dashboard container & settings"
    echo -e "  ${RED}•${NC} Dokploy PostgreSQL database & all admin credentials"
    echo -e "  ${RED}•${NC} Traefik proxy and routing certificates"
    echo -e "  ${RED}•${NC} Persistent volumes: ${BOLD}dokploy-postgres-data${NC}, ${BOLD}dokploy-data${NC}"
    if [ "$hard" = true ]; then
      echo -e "  ${RED}•${NC} All user-deployed applications on '${DOKPLOY_NETWORK}'"
    fi
    echo ""
    read -r -p "Are you sure you want to completely reset Dokploy? [y/N]: " confirm
    case "$confirm" in
      [yY][eE][sS]|[yY]) ;;
      *)
        echo "Reset aborted."
        return 0
        ;;
    esac
  fi

  echo -e "\n${BOLD}[${CMD_NAME}]${NC} Performing complete Dokploy reset..."

  if is_swarm_available; then
    # 1. Swarm mode cleanup
    echo -e "  ${YELLOW}->${NC} Removing Dokploy Swarm services..."
    $DOCKER_BIN service rm dokploy dokploy-postgres 2>/dev/null || true

    if [ "$hard" = true ]; then
      local net_id
      net_id=$(get_dokploy_net_id)
      if [ -n "$net_id" ]; then
        for s_id in $($DOCKER_BIN service ls -q 2>/dev/null); do
          $DOCKER_BIN service rm "$s_id" 2>/dev/null || true
        done
      fi
    fi

    echo -e "  ${YELLOW}->${NC} Stopping and removing Traefik proxy..."
    $DOCKER_BIN rm -f dokploy-traefik 2>/dev/null || true

    echo -e "  ${YELLOW}->${NC} Removing Docker Secrets..."
    $DOCKER_BIN secret rm dokploy_postgres_password dokploy_auth_secret 2>/dev/null || true

    echo -e "  ${YELLOW}->${NC} Removing network '${DOKPLOY_NETWORK}'..."
    $DOCKER_BIN network rm "$DOKPLOY_NETWORK" 2>/dev/null || true

    echo -e "  ${YELLOW}->${NC} Removing persistent volumes..."
    $DOCKER_BIN volume rm -f dokploy-postgres-data dokploy-data dokploy-postgres dokploy 2>/dev/null || true
  else
    # 2. Standalone Container Mode (Kiri / single-node Docker)
    echo -e "  ${YELLOW}->${NC} Stopping and removing core Dokploy containers..."
    $DOCKER_BIN rm -f dokploy dokploy-postgres dokploy-traefik 2>/dev/null || true

    if [ "$hard" = true ]; then
      echo -e "  ${YELLOW}->${NC} Removing all user containers on ${DOKPLOY_NETWORK}..."
      $DOCKER_BIN ps -a --filter "network=$DOKPLOY_NETWORK" -q 2>/dev/null | while IFS= read -r c_id; do
        [ -n "$c_id" ] && $DOCKER_BIN rm -f "$c_id" 2>/dev/null || true
      done
    fi

    echo -e "  ${YELLOW}->${NC} Removing network '${DOKPLOY_NETWORK}'..."
    $DOCKER_BIN network rm "$DOKPLOY_NETWORK" 2>/dev/null || true

    echo -e "  ${YELLOW}->${NC} Removing persistent volumes (database & config)..."
    $DOCKER_BIN volume rm -f dokploy-postgres-data dokploy-data dokploy-postgres dokploy 2>/dev/null || true
  fi

  # 3. Clean local state files
  if [ -d "$STATE_DIR" ]; then
    echo -e "  ${YELLOW}->${NC} Cleaning CLI state cache..."
    rm -f "$SVC_STATE" "$CONT_STATE" 2>/dev/null || true
  fi

  echo -e "\n${GREEN}✔ Dokploy has been completely reset to a clean state!${NC}"
  echo -e "To set up a fresh Dokploy instance anytime, run:"
  echo -e "  ${CYAN}${BOLD}${CMD_NAME} start${NC}"
}

# ------------------------------------------------------------------------------
# Install Dokploy & Autostart Management
# ------------------------------------------------------------------------------
install_dokploy() {
  check_docker

  if ! is_swarm_available; then
    install_dokploy_standalone
    return 0
  fi

  echo -e "${BOLD}[${CMD_NAME}]${NC} Installing Dokploy for local development (Swarm on ${OS_NAME})..."
  echo -e "  ${CYAN}->${NC} Deploying Dokploy Swarm services..."

  # Create overlay network
  $DOCKER_BIN network create --driver overlay --attachable dokploy-network 2>/dev/null || true

  # Generate secrets if not existing using cross-platform generator
  local pg_pass
  pg_pass="$(generate_random_secret 24)"
  echo "$pg_pass" | $DOCKER_BIN secret create dokploy_postgres_password - 2>/dev/null || true

  local auth_sec
  auth_sec="$(generate_random_secret 64)"
  echo "$auth_sec" | $DOCKER_BIN secret create dokploy_auth_secret - 2>/dev/null || true

  # Create postgres service
  if ! $DOCKER_BIN service inspect dokploy-postgres >/dev/null 2>&1; then
    echo -e "  ${CYAN}->${NC} Creating dokploy-postgres database service..."
    $DOCKER_BIN service create \
      --name dokploy-postgres \
      --constraint 'node.role==manager' \
      --network dokploy-network \
      --env POSTGRES_USER=dokploy \
      --env POSTGRES_DB=dokploy \
      --secret source=dokploy_postgres_password,target=/run/secrets/postgres_password \
      --env POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password \
      --mount type=volume,source=dokploy-postgres,target=/var/lib/postgresql/data \
      postgres:16 >/dev/null 2>&1 || true
  fi

  # Create dokploy service
  if ! $DOCKER_BIN service inspect dokploy >/dev/null 2>&1; then
    echo -e "  ${CYAN}->${NC} Creating dokploy web dashboard service..."
    $DOCKER_BIN service create \
      --name dokploy \
      --replicas 1 \
      --network dokploy-network \
      --mount type=bind,source="${ENGINE_SOCK}",target=/var/run/docker.sock \
      --mount type=volume,source=dokploy,target=/root/.docker \
      --secret source=dokploy_postgres_password,target=/run/secrets/postgres_password \
      --secret source=dokploy_auth_secret,target=/run/secrets/dokploy_auth_secret \
      --publish published=3000,target=3000,mode=host \
      --update-parallelism 1 \
      --update-order stop-first \
      --constraint 'node.role == manager' \
      -e POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password \
      -e BETTER_AUTH_SECRET_FILE=/run/secrets/dokploy_auth_secret \
      dokploy/dokploy:latest >/dev/null 2>&1 || true
  fi

  # Create traefik container
  if ! $DOCKER_BIN inspect dokploy-traefik >/dev/null 2>&1; then
    echo -e "  ${CYAN}->${NC} Starting dokploy-traefik proxy..."
    $DOCKER_BIN run -d \
      --name dokploy-traefik \
      --restart no \
      -p 80:80 \
      -p 443:443 \
      -v "${ENGINE_SOCK}:/var/run/docker.sock:ro" \
      --network dokploy-network \
      traefik:v3.1 >/dev/null 2>&1 || true
  fi

  # 3. Allow Dokploy services a moment to settle before reconfiguring
  echo -e "\n${BOLD}[${CMD_NAME}]${NC} Post-installation: removing auto-startup on boot..."
  sleep 4

  # 4. Remove auto-startup and stop to save RAM/CPU
  disable_autostart_dokploy --quiet

  echo -e "\n${GREEN}✔ Dokploy successfully installed and configured for local development!${NC}"
  echo -e "  ${BOLD}Auto-Startup on Boot:${NC} ${RED}DISABLED${NC}"
  echo -e "  Dokploy and Traefik will ${BOLD}NOT${NC} start automatically when your system or Docker boots."
  echo -e "  Whenever you want to use Dokploy, run:"
  echo -e "    ${CYAN}${BOLD}${CMD_NAME} start${NC}         # Start Dokploy + Traefik"
  echo -e "    ${CYAN}${BOLD}${CMD_NAME} start --core${NC}  # Start only Dokploy panel & DB"
  echo -e "    ${CYAN}${BOLD}${CMD_NAME} stop${NC}          # Stop Dokploy & free all RAM"
}

disable_autostart_dokploy() {
  check_docker
  local quiet=false
  [ "${1:-}" = "--quiet" ] && quiet=true

  if [ "$quiet" = false ]; then
    echo -e "${BOLD}[${CMD_NAME}]${NC} Removing auto-startup for Dokploy and Traefik..."
  fi

  # 1. Disable restart on standalone containers (Kiri / standard docker)
  for c in dokploy-traefik dokploy dokploy-postgres; do
    if $DOCKER_BIN inspect "$c" >/dev/null 2>&1; then
      [ "$quiet" = false ] && echo -e "  ${YELLOW}->${NC} Disabling restart on $c (--restart=no)..."
      $DOCKER_BIN update --restart=no "$c" >/dev/null 2>&1 || true
    fi
  done

  # 2. Disable restart condition on Swarm services if Swarm is used
  if is_swarm_available; then
    if $DOCKER_BIN service inspect dokploy >/dev/null 2>&1; then
      [ "$quiet" = false ] && echo -e "  ${YELLOW}->${NC} Disabling restart-condition on dokploy service..."
      $DOCKER_BIN service update --restart-condition none dokploy >/dev/null 2>&1 || true
      $DOCKER_BIN service scale dokploy=0 >/dev/null 2>&1 || true
    fi

    if $DOCKER_BIN service inspect dokploy-postgres >/dev/null 2>&1; then
      [ "$quiet" = false ] && echo -e "  ${YELLOW}->${NC} Disabling restart-condition on dokploy-postgres service..."
      $DOCKER_BIN service update --restart-condition none dokploy-postgres >/dev/null 2>&1 || true
      $DOCKER_BIN service scale dokploy-postgres=0 >/dev/null 2>&1 || true
    fi
  fi

  if [ "$quiet" = false ]; then
    echo -e "${GREEN}✔ Auto-startup disabled.${NC}"
    echo -e "  Dokploy core services and Traefik are stopped and will not launch on boot."
    echo -e "  Run ${CYAN}${BOLD}${CMD_NAME} start${NC} whenever you wish to use Dokploy."
  fi
}

enable_autostart_dokploy() {
  check_docker
  echo -e "${BOLD}[${CMD_NAME}]${NC} Enabling auto-startup on boot for Dokploy and Traefik..."

  if $DOCKER_BIN inspect dokploy-traefik >/dev/null 2>&1; then
    echo -e "  ${GREEN}->${NC} Setting Traefik restart policy to 'always'..."
    $DOCKER_BIN update --restart=always dokploy-traefik >/dev/null 2>&1 || true
    $DOCKER_BIN start dokploy-traefik >/dev/null 2>&1 || true
  fi

  if $DOCKER_BIN service inspect dokploy >/dev/null 2>&1; then
    echo -e "  ${GREEN}->${NC} Setting Dokploy service restart condition to 'any'..."
    $DOCKER_BIN service update --restart-condition any dokploy >/dev/null 2>&1 || true
    $DOCKER_BIN service scale dokploy=1 >/dev/null 2>&1 || true
  fi

  if $DOCKER_BIN service inspect dokploy-postgres >/dev/null 2>&1; then
    echo -e "  ${GREEN}->${NC} Setting Postgres service restart condition to 'any'..."
    $DOCKER_BIN service update --restart-condition any dokploy-postgres >/dev/null 2>&1 || true
    $DOCKER_BIN service scale dokploy-postgres=1 >/dev/null 2>&1 || true
  fi

  echo -e "${GREEN}✔ Auto-startup enabled.${NC}"
  echo -e "  Dokploy will now automatically start when Docker or your PC boots."
}

status_autostart_dokploy() {
  check_docker
  echo -e "${BOLD}Dokploy Auto-Startup Status:${NC}"

  local traefik_policy dok_cond pg_cond
  traefik_policy=$($DOCKER_BIN inspect dokploy-traefik --format '{{.HostConfig.RestartPolicy.Name}}' 2>/dev/null || echo "not-found")
  dok_cond=$($DOCKER_BIN service inspect dokploy --format '{{.Spec.TaskTemplate.RestartPolicy.Condition}}' 2>/dev/null || echo "not-found")
  pg_cond=$($DOCKER_BIN service inspect dokploy-postgres --format '{{.Spec.TaskTemplate.RestartPolicy.Condition}}' 2>/dev/null || echo "not-found")

  echo -e "  Traefik container restart policy: ${CYAN}${traefik_policy}${NC}"
  echo -e "  Dokploy panel restart condition:  ${CYAN}${dok_cond}${NC}"
  echo -e "  Dokploy database restart condition: ${CYAN}${pg_cond}${NC}"

  if [ "$traefik_policy" = "no" ] && [ "$dok_cond" = "none" ]; then
    echo -e "\nStatus: ${GREEN}Auto-startup is DISABLED.${NC} (Dokploy only runs on '${CMD_NAME} start')"
  else
    echo -e "\nStatus: ${YELLOW}Auto-startup is ENABLED.${NC} (Dokploy starts automatically on boot)"
    echo -e "To disable: ${CYAN}${CMD_NAME} autostart disable${NC} (or ${CYAN}${CMD_NAME} disable-autostart${NC})"
  fi
}

manage_autostart() {
  local action="${1:-status}"
  case "$action" in
    disable|off) disable_autostart_dokploy ;;
    enable|on) enable_autostart_dokploy ;;
    status|"") status_autostart_dokploy ;;
    *)
      echo "Usage: ${CMD_NAME} autostart [status|disable|enable]"
      ;;
  esac
}

# ------------------------------------------------------------------------------
# Uninstall Dokploy Local CLI
# ------------------------------------------------------------------------------
uninstall_cli() {
  local force=false
  for arg in "$@"; do
    case "$arg" in
      -f|--force|-y|--yes) force=true ;;
    esac
  done

  if [ "$force" = false ]; then
    echo -e "${YELLOW}Warning:${NC} This will remove the Dokploy CLI executable, aliases, and shell completions."
    read -r -p "Are you sure you want to uninstall? [y/N]: " confirm
    case "$confirm" in
      [yY][eE][sS]|[yY]) ;;
      *) echo "Uninstallation aborted."; return 0 ;;
    esac
  fi

  echo -e "${YELLOW}Uninstalling Dokploy CLI...${NC}"
  local bin_dir
  bin_dir="$(cd "$(dirname "$0")" && pwd)"

  # Remove binaries and symlinks from directory
  for name in dok dk dokploy "$CMD_NAME" "$CLI_NAME"; do
    if [ -f "$bin_dir/$name" ] || [ -L "$bin_dir/$name" ]; then
      echo -e "  Removing: $bin_dir/$name"
      rm -f "$bin_dir/$name"
    fi
    if [ -f "$bin_dir/$name.cmd" ]; then
      echo -e "  Removing: $bin_dir/$name.cmd"
      if command -v cmd.exe >/dev/null 2>&1; then
        local win_file
        win_file=$(cygpath -w "$bin_dir/$name.cmd" 2>/dev/null || echo "$bin_dir/$name.cmd")
        (cmd.exe /c "ping -n 2 127.0.0.1 >nul & del /f /q \"$win_file\"" >/dev/null 2>&1 &)
      else
        rm -f "$bin_dir/$name.cmd"
      fi
    fi
  done

  # Remove completions from shell configuration files across Linux and macOS
  for rc in "$HOME/.bashrc" "$HOME/.zshrc" "$HOME/.bash_profile" "$HOME/.zprofile"; do
    if [ -f "$rc" ]; then
      sed_inplace '/# >>> dokploy-cli autocompletion >>>/,/# <<< dokploy-cli autocompletion <<</d' "$rc"
    fi
  done

  # Remove config
  if [ -d "$CONFIG_DIR" ]; then
    echo -e "  Removing configuration: $CONFIG_DIR"
    rm -rf "$CONFIG_DIR"
  fi

  echo -e "${GREEN}✔ Dokploy Local CLI has been completely uninstalled.${NC}"
  exit 0
}

# ------------------------------------------------------------------------------
# Self-Update CLI
# ------------------------------------------------------------------------------
update_cli() {
  local force=false
  for arg in "$@"; do
    case "$arg" in
      -f|--force) force=true ;;
    esac
  done

  echo -e "${BOLD}[${CMD_NAME}]${NC} Checking for updates from GitHub (${CYAN}${GITHUB_REPO}${NC})..."

  local temp_file
  temp_file=$(mktemp -t dok_update.XXXXXX 2>/dev/null || mktemp /tmp/dok_update.XXXXXX 2>/dev/null || echo "/tmp/dok_update_temp")

  # Strategy 1: Download from GitHub Release asset (instant, no raw CDN cache)
  local dl_ok=false
  local release_url="https://github.com/${GITHUB_REPO}/releases/latest/download/dok"
  if command -v curl >/dev/null 2>&1; then
    (unset MSYS_NO_PATHCONV; curl -fsSL "$release_url" -o "$temp_file" 2>/dev/null) && dl_ok=true
  elif command -v wget >/dev/null 2>&1; then
    (unset MSYS_NO_PATHCONV; wget -qO "$temp_file" "$release_url" 2>/dev/null) && dl_ok=true
  fi

  # Strategy 2: If release asset not available, download from raw using commit SHA or branch
  if [ "$dl_ok" = false ] || ! grep -q "#!/usr/bin/env bash" "$temp_file" 2>/dev/null; then
    local commit_ref="${GITHUB_BRANCH:-main}"
    if command -v curl >/dev/null 2>&1; then
      local latest_sha
      latest_sha=$(curl -fsSL --connect-timeout 4 -H "User-Agent: dokploy-cli" "https://api.github.com/repos/${GITHUB_REPO}/commits/${commit_ref}" 2>/dev/null | grep -m1 '"sha":' | cut -d'"' -f4 || true)
      [ -n "$latest_sha" ] && commit_ref="$latest_sha"
    fi
    local remote_url="https://raw.githubusercontent.com/${GITHUB_REPO}/${commit_ref}/dok"
    if command -v curl >/dev/null 2>&1; then
      (unset MSYS_NO_PATHCONV; curl -fsSL "$remote_url" -o "$temp_file" 2>/dev/null) && dl_ok=true
    elif command -v wget >/dev/null 2>&1; then
      (unset MSYS_NO_PATHCONV; wget -qO "$temp_file" "$remote_url" 2>/dev/null) && dl_ok=true
    fi
  fi

  if [ "$dl_ok" = false ]; then
    echo -e "${RED}Error:${NC} Failed to fetch update from GitHub. Please check your internet connection." >&2
    rm -f "$temp_file"
    return 1
  fi

  # Validate downloaded script
  if ! grep -q "#!/usr/bin/env bash" "$temp_file" 2>/dev/null; then
    echo -e "${RED}Error:${NC} Invalid update file downloaded. Aborting." >&2
    rm -f "$temp_file"
    return 1
  fi

  local remote_version
  remote_version=$(grep -m1 '^VERSION=' "$temp_file" | cut -d'"' -f2)
  [ -z "$remote_version" ] && remote_version="latest"

  if [ "$force" = false ]; then
    if [ "$remote_version" = "$VERSION" ]; then
      echo -e "${GREEN}✔${NC} Dokploy Local CLI is already on the latest version (${CYAN}v${VERSION}${NC})."
      echo -e "  To force reinstall anyway, run: ${CYAN}${CMD_NAME} update --force${NC}"
      rm -f "$temp_file"
      return 0
    fi

    # Prevent accidental downgrades when remote version is older than local version
    if [ "$remote_version" != "latest" ] && command -v sort >/dev/null 2>&1; then
      local oldest
      oldest=$(printf '%s\n%s\n' "$VERSION" "$remote_version" | sort -V | head -n 1)
      if [ "$oldest" = "$remote_version" ]; then
        echo -e "${GREEN}✔${NC} Dokploy Local CLI is already on the latest version (${CYAN}v${VERSION}${NC})."
        echo -e "  (Remote: v${remote_version}, Local: v${VERSION})"
        echo -e "  To force reinstall anyway, run: ${CYAN}${CMD_NAME} update --force${NC}"
        rm -f "$temp_file"
        return 0
      fi
    fi
  fi

  echo -e "  Found update: ${CYAN}v${VERSION}${NC} -> ${GREEN}${BOLD}v${remote_version}${NC}"

  local current_bin
  current_bin="$(resolve_script_path "$0")"
  local bin_dir
  bin_dir="$(cd "$(dirname "$current_bin")" && pwd)"

  chmod +x "$temp_file"

  # Replace current executable
  if [ -w "$current_bin" ]; then
    mv -f "$temp_file" "$current_bin"
  else
    echo -e "  ${YELLOW}!${NC} Root permissions required to update $current_bin..."
    sudo mv -f "$temp_file" "$current_bin"
  fi

  # Ensure symlinks and Windows wrappers exist
  local cur_name
  cur_name="$(basename "$current_bin")"
  for alias_name in dok dk dokploy; do
    if [ "$alias_name" != "$cur_name" ]; then
      if [ -w "$bin_dir" ]; then
        rm -f "$bin_dir/$alias_name" 2>/dev/null || true
        ln -sf "$current_bin" "$bin_dir/$alias_name" 2>/dev/null || cp -f "$current_bin" "$bin_dir/$alias_name"
      else
        sudo rm -f "$bin_dir/$alias_name" 2>/dev/null || true
        sudo ln -sf "$current_bin" "$bin_dir/$alias_name" 2>/dev/null || sudo cp -f "$current_bin" "$bin_dir/$alias_name"
      fi
    fi
    # If on Windows, ensure Command Prompt and PowerShell wrapper exists
    if [ "$OS_TYPE" = "windows" ] || command -v explorer.exe >/dev/null 2>&1; then
      cat << EOFCMD > "$bin_dir/$alias_name.cmd"
@echo off
setlocal
set "SCRIPT_DIR=%~dp0"
if exist "%ProgramFiles%\\Git\\bin\\bash.exe" (
    "%ProgramFiles%\\Git\\bin\\bash.exe" "%SCRIPT_DIR%$alias_name" %*
) else (
    bash "%SCRIPT_DIR%$alias_name" %*
)
EOFCMD
    fi
  done

  echo -e "\n${GREEN}✔ Successfully updated Dokploy Local CLI to v${remote_version}!${NC}"
  echo -e "  Current binary: ${CYAN}$current_bin${NC}"
  echo -e "  Run ${CYAN}${CMD_NAME} version${NC} to verify."
}

# ------------------------------------------------------------------------------
# Alias & Command Name Management
# ------------------------------------------------------------------------------
manage_alias() {
  local action="${1:-list}"
  local new_alias="$2"

  local bin_dir
  bin_dir="$(cd "$(dirname "$0")" && pwd)"
  local target_file
  target_file="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

  case "$action" in
    add)
      if [ -z "$new_alias" ]; then
        echo -e "${RED}Error:${NC} Please specify an alias name: ${CMD_NAME} alias add <name>"
        echo -e "Examples: ${CYAN}${CMD_NAME} alias add dk${NC} or ${CYAN}${CMD_NAME} alias add dok${NC}"
        exit 1
      fi
      if [ -e "$bin_dir/$new_alias" ] && [ ! -L "$bin_dir/$new_alias" ]; then
        echo -e "${RED}Error:${NC} File '$bin_dir/$new_alias' already exists and is not a symlink."
        exit 1
      fi

      ln -sf "$target_file" "$bin_dir/$new_alias" 2>/dev/null || cp -f "$target_file" "$bin_dir/$new_alias"
      # If on Windows, also create the Command Prompt and PowerShell wrapper
      if command -v explorer.exe >/dev/null 2>&1 || [ -f "$bin_dir/dok.cmd" ]; then
        cat << EOFCMD > "$bin_dir/$new_alias.cmd"
@echo off
setlocal
set "SCRIPT_DIR=%~dp0"
if exist "%ProgramFiles%\\Git\\bin\\bash.exe" (
    "%ProgramFiles%\\Git\\bin\\bash.exe" "%SCRIPT_DIR%$new_alias" %*
) else (
    bash "%SCRIPT_DIR%$new_alias" %*
)
EOFCMD
      fi
      echo -e "${GREEN}✔${NC} Successfully added alias: ${BOLD}${CYAN}$new_alias${NC}"
      echo -e "You can now run commands as:"
      echo -e "  ${CYAN}$new_alias start${NC}"
      echo -e "  ${CYAN}$new_alias stop${NC}"
      echo -e "  ${CYAN}$new_alias status${NC}"
      ;;
    set)
      if [ -z "$new_alias" ]; then
        echo -e "${RED}Error:${NC} Please specify the primary name: ${CMD_NAME} alias set <name>"
        exit 1
      fi
      mkdir -p "$CONFIG_DIR"
      echo "CLI_NAME=\"$new_alias\"" > "$CONFIG_FILE"
      echo -e "${GREEN}✔${NC} Primary command name set to: ${BOLD}${CYAN}$new_alias${NC} in $CONFIG_FILE"
      ;;
    list|"")
      echo -e "${BOLD}Dokploy CLI Command Words & Aliases:${NC}"
      echo -e "  Currently running as: ${CYAN}${BOLD}$CMD_NAME${NC}"
      echo -e "  Configured default:   ${CYAN}${CLI_NAME}${NC}"
      echo -e "\nAvailable in ${bin_dir}:"
      for f in "$bin_dir"/dok* "$bin_dir"/dk*; do
        if [ -x "$f" ]; then
          local base
          base=$(basename "$f")
          if [ -L "$f" ]; then
            echo -e "  - ${CYAN}$base${NC} ${DIM}-> $(readlink "$f")${NC}"
          else
            echo -e "  - ${CYAN}${BOLD}$base${NC} (binary executable)"
          fi
        fi
      done
      echo -e "\n${DIM}Add another alias:${NC} ${CMD_NAME} alias add <name>"
      ;;
    *)
      echo "Usage: ${CMD_NAME} alias [list|add <name>|set <name>]"
      ;;
  esac
}

# ------------------------------------------------------------------------------
# Container Engine Management (Docker, Podman, Kiri)
# ------------------------------------------------------------------------------
manage_engine() {
  check_docker
  local action="${1:-status}"
  local new_engine="${2:-}"

  case "$action" in
    status|"")
      echo -e "${BOLD}======================================================${NC}"
      echo -e "${BOLD} Container Engine Status (${CYAN}${CMD_NAME}${NC}${BOLD})${NC}"
      echo -e "${BOLD}======================================================${NC}"
      echo -e "  Active Engine:      ${GREEN}${BOLD}${ENGINE_NAME}${NC}"
      echo -e "  CLI Executable:     ${CYAN}${ENGINE_BIN}${NC}"
      echo -e "  Engine Type:        ${CYAN}${ENGINE_TYPE}${NC}"
      echo -e "  Socket Path:        ${DIM}${ENGINE_SOCK}${NC}"
      local version_str
      version_str=$($ENGINE_BIN version --format '{{.Server.Version}}' 2>/dev/null || $ENGINE_BIN --version 2>/dev/null || echo "Unknown")
      echo -e "  Engine Version:     ${version_str}"
      echo ""
      echo -e "${BOLD}Detected Container Engines:${NC}"
      if command -v docker >/dev/null 2>&1; then
        local d_ctx
        d_ctx=$(docker context show 2>/dev/null || echo "default")
        echo -e "  ${GREEN}✔${NC} ${BOLD}docker${NC}  (Context: ${CYAN}${d_ctx}${NC})"
      else
        echo -e "  ${DIM}○ docker  (Not installed)${NC}"
      fi
      if command -v podman >/dev/null 2>&1; then
        echo -e "  ${GREEN}✔${NC} ${BOLD}podman${NC}  (Ready)"
      else
        echo -e "  ${DIM}○ podman  (Not installed)${NC}"
      fi
      if command -v kiri >/dev/null 2>&1 || (command -v docker >/dev/null 2>&1 && docker context ls 2>/dev/null | grep -qi "kiri"); then
        echo -e "  ${GREEN}✔${NC} ${BOLD}kiri${NC}    (Ready)"
      else
        echo -e "  ${DIM}○ kiri    (Not detected)${NC}"
      fi
      if command -v nerdctl >/dev/null 2>&1; then
        echo -e "  ${GREEN}✔${NC} ${BOLD}nerdctl${NC} (Ready)"
      else
        echo -e "  ${DIM}○ nerdctl (Not installed)${NC}"
      fi
      echo ""
      echo -e "${DIM}Switch engine anytime:${NC} ${CMD_NAME} engine set <docker|podman|kiri|nerdctl|auto>"
      ;;
    set)
      if [ -z "$new_engine" ]; then
        echo -e "${RED}Error:${NC} Please specify an engine: ${CMD_NAME} engine set <docker|podman|kiri|auto>"
        return 1
      fi
      mkdir -p "$CONFIG_DIR"
      if [ -f "$CONFIG_FILE" ] && grep -q "^CONTAINER_ENGINE=" "$CONFIG_FILE" 2>/dev/null; then
        sed_inplace "s/^CONTAINER_ENGINE=.*/CONTAINER_ENGINE=\"$new_engine\"/" "$CONFIG_FILE"
      else
        echo "CONTAINER_ENGINE=\"$new_engine\"" >> "$CONFIG_FILE"
      fi
      echo -e "${GREEN}✔${NC} Default container engine set to: ${BOLD}${CYAN}${new_engine}${NC} in $CONFIG_FILE"
      echo -e "Run ${CYAN}${CMD_NAME} engine status${NC} to verify."
      ;;
    list)
      echo -e "${BOLD}Available Container Engines on System:${NC}"
      for eng in docker podman kiri nerdctl; do
        if command -v "$eng" >/dev/null 2>&1 || [ "$eng" = "kiri" -a -n "$(docker context ls 2>/dev/null | grep -i kiri)" ]; then
          echo -e "  ${GREEN}●${NC} ${BOLD}$eng${NC} [Available]"
        else
          echo -e "  ${DIM}○ $eng [Not installed]${NC}"
        fi
      done
      ;;
    *)
      echo "Usage: ${CMD_NAME} engine [status|list|set <docker|podman|kiri|nerdctl|auto>]"
      ;;
  esac
}

# ------------------------------------------------------------------------------
# Shell Completion Generators
# ------------------------------------------------------------------------------
generate_bash_completion() {
  cat << 'EOF'
_dokploy_completion() {
  local cur prev cword
  if [ -n "$BASH_VERSION" ]; then
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    cword=$COMP_CWORD
  fi

  local commands="start up stop down restart status ps logs log open ui clean prune reset alias engine autostart disable-autostart install-dokploy update upgrade uninstall completion version help -h --help -v --version"

  if [ "$cword" -eq 1 ]; then
    COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
    return 0
  fi

  case "${COMP_WORDS[1]}" in
    start|up|stop|down|restart)
      COMPREPLY=( $(compgen -W "--core -c" -- "$cur") )
      ;;
    logs|log)
      if [ "$cword" -eq 2 ]; then
        local targets="panel db traefik -f --follow -n --tail"
        COMPREPLY=( $(compgen -W "$targets" -- "$cur") )
      else
        COMPREPLY=( $(compgen -W "-f --follow -n --tail" -- "$cur") )
      fi
      ;;
    clean|prune)
      COMPREPLY=( $(compgen -W "--force -f --all -a" -- "$cur") )
      ;;
    reset)
      COMPREPLY=( $(compgen -W "--force -f -y --yes --hard" -- "$cur") )
      ;;
    alias)
      COMPREPLY=( $(compgen -W "add set list" -- "$cur") )
      ;;
    engine)
      COMPREPLY=( $(compgen -W "status list set" -- "$cur") )
      ;;
    autostart)
      COMPREPLY=( $(compgen -W "status disable enable" -- "$cur") )
      ;;
    update|upgrade)
      COMPREPLY=( $(compgen -W "--force -f" -- "$cur") )
      ;;
    uninstall)
      COMPREPLY=( $(compgen -W "--force -f -y --yes" -- "$cur") )
      ;;
    completion)
      COMPREPLY=( $(compgen -W "bash zsh" -- "$cur") )
      ;;
  esac
}
EOF
  echo "complete -F _dokploy_completion dok dk dokploy $CMD_NAME $CLI_NAME"
}

